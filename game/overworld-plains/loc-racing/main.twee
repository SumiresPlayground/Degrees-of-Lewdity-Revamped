<</if>>
The board changes one last time while the bookie calls for final bets.
<<print setup.horserace.renderHorseList()>>
<<if $horserace.lastError>>
	<p class="red"><<print $horserace.lastError>></p>
<</if>>
<<if !$horserace.selectedHorseId>>
	Choose a horse to back.
	<p class="horse-race-bet-links">
	<<set _firstHorseLink to true>><<for _horse range $horserace.horses>><<if _firstHorseLink>><<set _firstHorseLink to false>><<else>> <br> <</if>><<set _label to _horse.name + " (" + _horse.odds.toFixed(2) + "x)">><<capture _horse>><<link _label "Racecourse Betting">><<set $horserace.selectedHorseId to _horse.id>><</link>><</capture>><</for>>
	</p>
<<else>>
	<<set _horse to setup.horserace.getHorse($horserace.selectedHorseId)>>
	You choose <<print _horse.name>>. Enter the amount you want to bet.
	<br>
	<<if $weeklybetamount is undefined>>
	<<set $weeklybetamount to 0>>
	<</if>>
	<<if $money gte 10000 and $weeklybetamount lt 4000>>
		<<link [[Bet £100|Racecourse Betting Submit]]>><<set $horserace.betInput to 100>><</link>><br>
	<<else>>
		<span class='red'>You do not have enough money to place a bet.</span><br>
	<</if>>
	<<if $money gte 20000 and $weeklybetamount lt 4000>>
		<<link [[Bet £200|Racecourse Betting Submit]]>><<set $horserace.betInput to 200>><</link>><br>
	<</if>>
	<<if $money gte 50000 and $weeklybetamount lt 4000>>
		<<link [[Bet £500|Racecourse Betting Submit]]>><<set $horserace.betInput to 500>><</link>><br>
	<</if>>
	<<if $money gte 100000 and $weeklybetamount lt 4000>>
		<<link [[Bet £1000|Racecourse Betting Submit]]>><<set $horserace.betInput to 1000>><</link>><br>
	<</if>>
	<<if $money gte 200000 and $weeklybetamount lt 4000>>
		<<link [[Bet £2000|Racecourse Betting Submit]]>><<set $horserace.betInput to 2000>><</link>><br>
	<</if>>
	<<if $weeklybetamount gt 4000>>
		<span class='red'>You are barred from horse betting for the next week.</span><br>
	<</if>>
	<br>
	<<link "Choose a different horse" "Racecourse Betting">><<set $horserace.selectedHorseId to "">><<unset $horserace.betFieldId>><</link>>
	<br>
<</if>>
<<getouticon>><<link [[Leave|Race Track]]>><<set $horserace.betInput to 0>><</link>>

