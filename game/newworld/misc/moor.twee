<<elseif $enemyhealth lte 0>>
	<span id="next"><<link [[Next|Moor Dragons Rape End]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|Moor Dragons Rape]]>><</link>></span><<nexttext>>
<</if>>

