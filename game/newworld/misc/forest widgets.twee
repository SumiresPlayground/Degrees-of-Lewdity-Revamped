:: Widgets Forest New World [widget]

<<widget "forestraccoon">>
	A pair of eyes stare out from a hollowed out tree burrow.
	<<gstress>><<stress 6>>
	<br><br>
	<<beastNEWinit 1 raccoon>>
	<<if $deviancy gte 35 and ($settings.bestialityEnabled or $monster is 1)>>
		<br>
		<<link [[Adopt mating posture|Forest Raccoon]]>><</link>><<deviant3>>
		<br>
	<</if>>
	<<link [[Continue|Forest]]>><<endevent>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><<set $eventskip to 1>><</link>>
	<br>
<</widget>>

<<widget "forestdragon">>

	You spot large unnatural footprints in the dirt.
	<br><br>
	<<beastNEWinit 1 dragon>>
	<<if $foresthunt gte 1>>
	You feel whatever's hunting you draw closer.
	<br><br>
	<</if>>

	<<link [[Take a detour (0:30)|Forest]]>><<endevent>><<pass 30>><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><<set $eventskip to 1>><</link>>
	<br>
	<<if random(1, 2) is 2 and ($settings.bestialityEnabled or $monster is 1)>>
	<<link [[Ignore them|Forest Dragon Molestation]]>><<set $molestationstart to 1>><</link>>
	<br>
	<<else>>
	<<link [[Ignore them|Forest]]>><<endevent>><<set $eventskip to 1>><</link>>
	<br>
	<</if>>
<</widget>>

<<widget "forestbearobserve">>
	You catch sight of a bear by a stream downhill.
	<br><br>

	<<beastNEWinit 1 bear>>
	<<if $foresthunt gte 1>>
		You feel whatever's hunting you draw closer.
		<br><br>
	<</if>>

	<<link [[Observe from cover (0:30)|Forest]]>><<endevent>><<transform bear 1>><<pass 30>><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><<set $eventskip to 1>><</link>>
	<br>
	<!-- Modified for Monster People -->
	<<if random(1, 5) is 5 and ($settings.bestialityEnabled or $monster is 1)>>
		<<link [[Ignore them|Forest Bear Molestation]]>><<set $molestationstart to 1>><</link>>
		<br>
	<<else>>
		<<link [[Ignore them|Forest]]>><<endevent>><<set $eventskip to 1>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "eyeStyleOptions">>
	Your current eye style is:
	<<listbox "_facestyle" autoselect>>
		<<optionsfrom setup.faceStyleOptions>>
	<</listbox>>
	<br>
	<<link "Apply">>
		<<if $facestyle isnot _facestyle>>
			<<set $facestyle to _facestyle>>
			<<set $facevariant to "default">>
			<<replace "#visualsFaceVariantRadios">><<eyeVariantOptions>><</replace>>
			<<updatesidebarimg true>>
		<</if>>
	<</link>>
<</widget>>

<<widget "eyeVariantOptions">>
	<<if Object.keys(setup.faceVariantOptions[$facestyle]).length gt 1>>
		Your current eye style is:
		<<listbox "$eyevariant" autoselect>>
			<<optionsfrom setup.faceVariantOptions[$facestyle]>>
		<</listbox>>
		<br>
		<<run $(() => {
			$("#listbox-eyevariant").on("change", () => {
				Wikifier.wikifyEval('<<updatesidebarimg true>>');
			});
		})>>
	<<else>>
		There are
		<mouse class = "gold tooltip-small" style="border-bottom-color:white">
			no alternative eye styles available.
			<span class="blue">
				Selecting a different eye style may make additional styles available to you.
			</span>
		</mouse>
	<</if>>
<</widget>>

<<widget "mouthStyleOptions">>
	Your current mouth style is:
	<<listbox "_facestyle" autoselect>>
		<<optionsfrom setup.faceStyleOptions>>
	<</listbox>>
	<br>
	<<link "Apply">>
		<<if $facestyle isnot _facestyle>>
			<<set $facestyle to _facestyle>>
			<<set $facevariant to "default">>
			<<replace "#visualsFaceVariantRadios">><<mouthVariantOptions>><</replace>>
			<<updatesidebarimg true>>
		<</if>>
	<</link>>
<</widget>>

