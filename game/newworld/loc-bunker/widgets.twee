<<widget "apotropaic">>
	<<if $worn.face.type.includes("apotropaic")>>
		<span class="wraith">Your mask repelled an invader.</span>
	<<elseif $worn.over_head.type.includes("apotropaic")>>
		<span class="wraith">Your head talisman repelled an invader. They flutter to the ground, drained.</span>
		<<overheadruined>>
	<<elseif $worn.over_upper.type.includes("apotropaic")>>
		<span class="wraith">Your upper talismans repelled an invader. They flutter to the ground, drained.</span>
		<<overupperruined>>
	<<elseif $worn.over_lower.type.includes("apotropaic")>>
		<span class="wraith">Your lower talismans repelled an invader. They flutter to the ground, drained.</span>
		<<overlowerruined>>
	<<elseif $worn.under_upper.type.includes("apotropaic")>>
		<span class="wraith">Your chest talismans repelled an invader. They flutter to the ground, drained.</span>
		<<underupperruined>>
	<<elseif $worn.under_lower.type.includes("apotropaic")>>
		<span class="wraith">Your groin talismans repelled an invader. They flutter to the ground, drained.</span>
		<<underlowerruined>>
	<</if>>
<</widget>>