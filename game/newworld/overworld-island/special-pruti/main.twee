		<<endevent>>
	<</link>>
<<else>>
	<<link [[Exit Pruti's Hut|Misland]]>><<sleepDoll>><<stress -1000>><<set $islanddistance to 45>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>

