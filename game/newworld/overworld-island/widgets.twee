:: Widgets Misland [widget]

<<widget "passoutisland">>
    You've pushed yourself too much.
    <br><br>
    <<passout>>

	<<rng 1 10>>
    <<if $rng gt 3>>
    	<<link [[Wake up|Misland Rape]]>><<strip>><</link>>
	<<else>>
		<<if $NPCName[$NPCNameList.indexOf("Pruti")].love gte 50>>
			<<link [[Wake up|Pruti Save]]>><<strip>><</link>>
		<<else>>
			<<link [[Wake up|Witch Intro]]>><<strip>><</link>>
		<</if>>
    <</if>>
<</widget>>

<<widget "eventislanditem">>
	<<cleareventpool>>
    <<if $location is "beach">>
        <<addinlineevent "cannonball">>
			You stub your toe on something hard under the sand.
			<br><br>
			Digging it up reveals an old cannonball.
			<br><br>
			<<set $antiquemoney += 100>><<museumAntiqueStatus "antiquecannonball" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
	<<elseif $location is "desert">>
        <<addinlineevent "arttablet">>
			You spot a small stone corner sticking out of the sand.
			<br><br>
			Digging it up reveals an old painted stone tablet.
			<br><br>
			<<set $antiquemoney += 150>><<museumAntiqueStatus "antiquearttablet" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
		<<addinlineevent "terracottastatue">>
			You find a small structure in the desert.
			<br><br>
			The place is completely empty except for a small terracotta statue.
			<br><br>
			<<set $antiquemoney += 250>><<museumAntiqueStatus "antiqueterracottastatue" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
    <<elseif $location is "mforest">>
        <<if $museumAntiques.antiques.antiqueredvial is undefined or $museumAntiques.antiques.antiqueredvial is "notFound">>
			<<addinlineevent "redvial">>
				As you traverse the slick damp forest you slip in the mud.
				<br><br>
				You get up wiping yourself up before something catches your eye. Half sunk in the mud you find an odd red vial.
				<br><br>
				<<set $antiquemoney += 2000>><<museumAntiqueStatus "antiqueredvial" "found">>
				<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
			<</addinlineevent>>
		<</if>>
		<<addinlineevent "tribemask">>
			While walking you find an old path leading to what looks like a large mound.
			<br><br>
			Hanging on a nearby tree is an old looking stone mask.
			<br><br>
			<<set $antiquemoney += 250>><<museumAntiqueStatus "antiquetribemask" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
		<<addinlineevent "ebonystatuette">>
			While exploring you find a dilapidated wooden shack.
			<br><br>
			The place looks like a mess but you find an old ebony statuette tucked inside a drawer.
			<br><br>
			<<set $antiquemoney += 400>><<museumAntiqueStatus "antiqueebonystatuette" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
	<<elseif $location is "glacier">>
        <<addinlineevent "glacierplant">>
			As you traverse the glacier you slip on the ice and fall.
			<br><br>
			You start to get up but see something under the ice. You take a moment to dig them out and find some frozen seeds.
			<br><br>
			<<set $antiquemoney += 500>><<museumAntiqueStatus "antiqueglacierplant" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "eventisland">>
	<<cleareventpool>>
    <<if $location is "desert" or $location is "beach">>
		<<if beastSexEnabledForType("ant", $monster is 1)>>
			<<addevent "islandant">>
		<</if>>
		<<if beastSexEnabledForType("hawk", $monster is 1)>>
			<<addevent "islandhawk">>
		<</if>>
		<<if beastSexEnabledForType("lizard", $monster is 1)>>
			<<addevent "islandlizard">>
		<</if>>
    <<elseif $location is "mforest">>
		<<if beastSexEnabledForType("wolf", $monster is 1)>>
       		<<addevent "islandwolf">>
		<</if>>
		<<if beastSexEnabledForType("boar", $monster is 1)>>
			<<addevent "islandboar">>
		<</if>>
		<<if beastSexEnabledForType("cat", $monster is 1)>>
			<<addevent "islandcat">>
		<</if>>
        <<if $settings.lurkersEnabled>>
			<<addevent "islandlurker">>
		<</if>>
		<<if $settings.voreEnabled>>
			<<addevent "islandsnake">>
		<</if>>
	<<elseif $location is "glacier">>
		<<if beastSexEnabledForType("bear", $monster is 1)>>
			<<addevent "islandbear">>
		<</if>>
		<<if beastSexEnabledForType("wolf", $monster is 1)>>
			<<addevent "islandgwolf">>
		<</if>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "eventislandsafe">>
	<<cleareventpool>>
    <<if $location is "beach">>
        <<addinlineevent "safeisland_beach">>
			A fresh ocean breeze brushes your skin and relaxes you.
			<<lstress>><<stress -1>>
			<br><br>

			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
	<<elseif $location is "desert">>
        <<addinlineevent "safeisland_sandstorm">>
			A gust of wind starts up blowing sand everywhere. It stings your eyes and lowers visibility.
			<<gstress>><<stress 1>>
			<<gpain>><<pain 2>>
			<br><br>

			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
    <<elseif $location is "mforest">>
        <<addinlineevent "safeisland_wolfhowl">>
			You hear a wolf howl in the distance.
			<<if $transformationParts.wolf.tail isnot "disabled">>
				<<garousal>><<arousal 600>>
			<<else>>
				<<gstress>><<stress 1>>
			<</if>>
			<br><br>

			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
			<br>
		<</addinlineevent>>
	<<elseif $location is "glacier">>
        <<addinlineevent "safeisland_snowstorm">>
			A gust of wind starts up blowing snow everywhere. It makes it really hard to see.
			<<gstress>><<stress 1>>
			<br><br>

			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "islandwolf">>
	<<beastNEWinit 1 wolf>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> emerges from between the trees, teeth bared.
	<<if $monster is 1>>
		"Found you," <<bhe>> barks. "Mine."
	<</if>>
	<br><br>
	<<link [[Next|Misland Wolf]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandgwolf">>
	<<beastNEWinit 1 wolf>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> emerges from the snowy mist.
	<<if $monster is 1>>
		"Found you," <<bhe>> barks. "Mine."
	<</if>>
	<br><br>
	<<link [[Next|Misland Wolf]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandhawk">>
	<<beastNEWinit 1 hawk>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> swoops down from the sky, talons at the ready.
	<<if $monster is 1>>
		"Lets play." <<bhe>> screeches.
	<</if>>
	<br><br>
	<<link [[Next|Misland Hawk]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandcat">>
	<<beastNEWinit 1 cat>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> slinks silently from the tree tops, claws sharpened toward you.
	<<if $monster is 1>>
		"My next meal." <<bhe>> licks <<bhis>> lips.
	<</if>>
	<br><br>
	<<link [[Next|Misland Cat]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandlizard">>
	<<beastNEWinit 1 lizard>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> digs up from the sand, fangs bared.
	<<if $monster is 1>>
		"Come into the sand." <<bhe>> croaks.
	<</if>>
	<br><br>
	<<link [[Next|Misland Lizard]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandsnake">>
	A long snake slides down from the treetops blocking your path with its huge slick body, it bares its fangs as it grabs you and begins to force you into its throat.
	<br><br>
	<<link [[Next|Misland Snake]]>><<set $molestationstart to 1>><<set $trance to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandboar">>
	<<beastNEWinit 1 boar>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> scampers from the brush, its tusks aim menacingly toward you.
	<<if $monster is 1>>
		"Get down now." <<bhe>> snorts.
	<</if>>
	<br><br>
	<<link [[Next|Misland Boar]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandant">>
	<<beastNEWinit 1 ant>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> emerges from the sand, gnashing its teeth.
	<<if $monster is 1>>
		"Invader," <<bhe>> cackles. "Mine."
	<</if>>
	<br><br>
	<<link [[Next|Misland Ant]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandlurker">>
	As you cross the mountain something leaps from the pile of <<if Weather.precipitation === "snow">>snow<<else>>leaves<</if>>
	<br><br>
	<<link [[Next|Misland Struggle]]>><<set $struggle_start to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandbear">>
	<<beastNEWinit 1 bear>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> emerges from snow, glaring at you with piercing eyes.
	<<if $monster is 1>>
		"Food," <<bhe>> cackles.
	<</if>>
	<br><br>
	<<link [[Next|Misland Bear]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "callDoll">>
	<<if $ghost gte 1>>
		<<set $bodyless to 1>><<set $ghostrestore to $ghost>><<clearExtraTransformations>>
	<</if>>
	<<if $slime gte 1>>
		<<set $bodyless to 1>><<set $slimerestore to $slime>><<clearExtraTransformations>>
	<</if>>
	<<if $mushroom gte 1>>
		<<set $bodyless to 1>><<set $mushroomrestore to $mushroom>><<set $mushroomtfrestore to $mushroomtf>><<set $fungalrestore to $fungalgrowth>><<clearExtraTransformations>>
	<</if>>
	<<script>>
		const skipKeysOnFreeze = ["replayScene", "frozenValues", "statFreeze", "passage", "debug", "debugMenu", "options"];
		V.frozenValues1 = {};
		V.frozenValues1.deepMerge(V, (key, value, depth) => {
			return !(depth === 1 && skipKeysOnFreeze.includes(key)) && typeof value !== "function";
		});
	<</script>>
	<<set $worn.genitals to clone(setup.clothes.genitals[0])>>
	<<run delete V.worn.butt_plug>>
	<<set $clothingrebuy to 0>>
	<<if $worn.neck.cursed is 1>>
		<<set $worn.neck.type.push("broken")>>
		<<neckruined>>
	<</if>>

	<<for _bodypart range $parasite.bodyparts>>
		<<set $parasite[_bodypart] to {}>>
	<</for>>
	<<set dhmod.hair.is_custom to false>>
	<<set dhmod.fringe.is_custom to false>>
	<<resetEarSlime>>
	<<parasiteinit>>
	<<bodyliquid "clear">>
	<<bodywriting_init>>
	<<rng>>
	<<if $permadoll is 1>>
		<<if $doll is "female">>
			<<set $player.gender to "f">>
			<<set $player.gender_appearance to "f">>
			<<set $player.sex to "f">>
			<<set $vaginastate to 0>>
			<<set $vaginause to 0>>
			<<set $penisuse to "none">>
			<<set $penisstate to "none">>
			<<set $sexStats.vagina.menstruation.running = true>>
			<<set $player.breastsize to 5>>
			<<set $player.penisExist to false>>
			<<set $player.ballsExist to false>>
			<<set $player.vaginaExist to true>>
		<<elseif $doll is "male">>
			<<set $player.gender to "m">>
			<<set $player.gender_appearance to "m">>
			<<set $player.sex to "m">>
			<<set $vaginastate to 0>>
			<<set $vaginause to 0>>
			<<set $penisuse to "none">>
			<<set $penisstate to "none">>
			<<set $player.breastsize to 0>>
			<<set $player.penisExist to true>>
			<<set $player.ballsExist to true>>
			<<set $player.penissize to 4>>
			<<set $player.vaginaExist to false>>
			<<set $sexStats.vagina.menstruation.running = false>>
		<<elseif $doll is "both">>
			<<set $vaginause to 0>>
			<<set $vaginastate to 0>>
			<<set $penisuse to 0>>
			<<set $penisstate to 0>>
			<<set $player.sex to "h">>
			<<set $player.penisExist to true>>
			<<set $player.vaginaExist to true>>
			<<set $sexStats.vagina.menstruation.running = true>>
			<<set $player.breastsize to 0>>
			<<set $player.penisExist to true>>
			<<set $player.ballsExist to true>>
			<<set $player.penissize to 4>>
			<<set $player.vaginaExist to false>>
		<</if>>
	<<elseif $player.gender_appearance is "f">>
		<<if $settings.forcedCrossdressingEnabled and $rng gte 51>>
			<<set $player.gender to "f">>
			<<set $player.gender_appearance to "f">>
			<<set $player.sex to "f">>
			<<set $vaginastate to 0>>
			<<set $vaginause to 0>>
			<<set $penisuse to "none">>
			<<set $penisstate to "none">>
			<<set $sexStats.vagina.menstruation.running = false>>
			<<set $player.breastsize to 5>>
			<<set $player.penisExist to false>>
			<<set $player.ballsExist to false>>
			<<set $player.vaginaExist to true>>
		<<else>>
			<<set $player.gender to "m">>
			<<set $player.gender_appearance to "m">>
			<<set $player.sex to "m">>
			<<set $vaginastate to 0>>
			<<set $vaginause to 0>>
			<<set $penisuse to "none">>
			<<set $penisstate to "none">>
			<<set $sexStats.vagina.menstruation.running = true>>
			<<set $player.breastsize to 0>>
			<<set $player.penisExist to true>>
			<<set $player.ballsExist to true>>
			<<set $player.penissize to 4>>
			<<set $player.vaginaExist to false>>
		<</if>>
	<<else>>
		<<if $settings.forcedCrossdressingEnabled and $rng gte 51>>
			<<set $player.gender to "m">>
			<<set $player.gender_appearance to "m">>
			<<set $player.sex to "m">>
			<<set $vaginastate to 0>>
			<<set $vaginause to 0>>
			<<set $penisuse to "none">>
			<<set $penisstate to "none">>
			<<set $sexStats.vagina.menstruation.running = false>>
			<<set $player.breastsize to 0>>
			<<set $player.penisExist to true>>
			<<set $player.ballsExist to true>>
			<<set $player.penissize to 4>>
			<<set $player.vaginaExist to false>>
		<<else>>
			<<set $player.gender to "f">>
			<<set $player.gender_appearance to "f">>
			<<set $player.sex to "f">>
			<<set $vaginastate to 0>>
			<<set $vaginause to 0>>
			<<set $penisuse to "none">>
			<<set $penisstate to "none">>
			<<set $sexStats.vagina.menstruation.running = true>>
			<<set $player.breastsize to 5>>
			<<set $player.penisExist to false>>
			<<set $player.ballsExist to false>>
			<<set $player.vaginaExist to true>>
		<</if>>
	<</if>>
	<<set $frozenValues1.skincolor to Skin.color.natural>>
	<<if $permadoll isnot 1>>
		<<set $leftEyeColour to "brown">>
		<<set $rightEyeColour to "brown">>
		<<set $haircolour to "black">>
		<<set $hairfringecolour to "black">>
		<<set $makeup.browscolour to "black">>
		<<set $hairColourStyle to "simple">>
		<<set $hairFringeColourStyle to "simple">>
		<<set $hairlength to 400>>
		<<set Skin.color.natural to "rmedium">>
		<<set $frozenValues1.eyevariant to $eyevariant>>
		<<set $frozenValues1.mouthvariant to $mouthvariant>>
		<<set $facestyle to "default">>
		<<set $facevariant to "gloomy">>
		<<set $eyevariant to "gloomy">>
		<<set $mouthvariant to "gloomy">>
	<</if>>

	<<run Object.keys(V.transformationParts).forEach((tf) => {
		Object.entries(V.transformationParts[tf]).forEach(([part, value]) => {
			if (value !== 'disabled') {
				V.transformationParts[tf][part] = 'disabled';
			}
		});
	})>>

	<<set V.transformationParts.doll.body to "default">>
	<<set V.transformationParts.doll.arms to "default">>
	<<set $dollstate to 1>>
	<<if $permadoll is 1>>
		<<set V.transformationParts.doll.string to "default">>
		<<set $dollstate to 2>>
	<</if>>
<</widget>>

<<widget "sleepDoll">>
	<<set $player to clone($frozenValues1.player)>>
	<<set $worn to clone($frozenValues1.worn)>>
	<<set $fringetype to clone($frozenValues1.fringetype)>>
	<<set $fringelength to clone($frozenValues1.fringelength)>>
	<<set $fringelengthstage to clone($frozenValues1.fringelengthstage)>>
	<<set $hairtype to clone($frozenValues1.hairtype)>>
	<<set $hairlength to clone($frozenValues1.hairlength)>>
	<<set $hairlengthstage to clone($frozenValues1.hairlengthstage)>>
	<<set $haircolour to clone($frozenValues1.haircolour)>>
	<<set $hairColourGradient to clone($frozenValues1.hairColourGradient)>>
	<<set $hairfringecolour to clone($frozenValues1.hairfringecolour)>>
	<<set $hairFringeColourGradient to clone($frozenValues1.hairFringeColourGradient)>>
	<<set $skin to clone($frozenValues1.skin)>>
	<<set $parasite to clone($frozenValues1.parasite)>>
	<<set $transformationParts to clone($frozenValues1.transformationParts)>>
	<<set Skin.color.natural to $frozenValues1.skincolor>>
	<<set $eyevariant to $frozenValues1.eyevariant>>
	<<set $mouthvariant to $frozenValues1.mouthvariant>>
	<<if $ghostrestore is 1>>
		<<set Skin.color.natural to "ghost">>
		<<set V.transformationParts.ghost.eyes to "default">>
		<<set V.transformationParts.ghost.hitodama to "default">>
		<<set $haircolour to "ghost">>
		<<set $hairfringecolour to "ghost">>
		<<set $makeup.browscolour to "ghost">>
		<<set $options.lightGlow to 1>>
		<<set $ghost to $ghostrestore>>
	<<elseif $ghostrestore is 2>>
		<<set Skin.color.natural to "ice">>
		<<set V.transformationParts.ghost.eyes to "default">>
		<<set V.transformationParts.ghost.mist to "default">>
		<<set $haircolour to "snowblue">>
		<<set $hairfringecolour to "snowblue">>
		<<set $makeup.browscolour to "snowblue">>
		<<set $options.lightGlow to 1>>
		<<set $ghost to $ghostrestore>>
	<<elseif $ghostrestore is 3>>
		<<set Skin.color.natural to "flame">>
		<<set V.transformationParts.ghost.eyes to "default">>
		<<set V.transformationParts.ghost.flame to "default">>
		<<set $haircolour to "ghost">>
		<<set $hairfringecolour to "ghost">>
		<<set $makeup.browscolour to "ghost">>
		<<set $options.lightGlow to 1>>
		<<set $ghost to $ghostrestore>>
	<<elseif $ghostrestore is 4>>
		<<set Skin.color.natural to "water">>
		<<set V.transformationParts.ghost.eyes to "default">>
		<<set V.transformationParts.ghost.stream to "default">>
		<<set $haircolour to "ghostblue">>
		<<set $hairfringecolour to "ghostblue">>
		<<set $makeup.browscolour to "ghostblue">>
		<<set $options.lightGlow to 1>>
		<<set $ghost to $ghostrestore>>
	<<elseif $slimerestore is 1>>
		<<set Skin.color.natural to "slimy">>
		<<set V.transformationParts.slime.bubble to "default">>
		<<set V.transformationParts.slime.stream to "default">>
		<<set V.transformationParts.slime.core to "default">>
		<<set $haircolour to "slimegreen">>
		<<set $hairfringecolour to "slimegreen">>
		<<set $makeup.browscolour to "slimegreen">>
		<<set $slime to $slimerestore>>
	<<elseif $slimerestore is 2>>
		<<set Skin.color.natural to "amethyst">>
		<<set V.transformationParts.slime.bubble to "pdefault">>
		<<set V.transformationParts.slime.stream to "pdefault">>
		<<set V.transformationParts.slime.core to "default">>
		<<set $haircolour to "lilacpurple">>
		<<set $hairfringecolour to "lilacpurple">>
		<<set $makeup.browscolour to "lilacpurple">>
		<<set $slime to $slimerestore>>
	<<elseif $slimerestore is 3>>
		<<set Skin.color.natural to "chilly">>
		<<set V.transformationParts.slime.bubble to "bdefault">>
		<<set V.transformationParts.slime.stream to "bdefault">>
		<<set V.transformationParts.slime.core to "default">>
		<<set $haircolour to "chillyblue">>
		<<set $hairfringecolour to "chillyblue">>
		<<set $makeup.browscolour to "chillyblue">>
		<<set $slime to $slimerestore>>
	<<elseif $mushroomrestore gte 1>>
		<<set Skin.color.natural to "dusky">>
		<<set $transformationParts.mushroom.cap to "default">>
		<<set $transformationParts.mushroom.eyes to "default">>
		<<set $transformationParts.mushroom.spores to "default">>
		<<set $transformationParts.mushroom.mushrooms to "default">>
		<<set $haircolour to "amberyellow">>
		<<set $makeup.browscolour to "amberyellow">>
		<<set $hairfringecolour to "amberyellow">>
		<<set $makeup.browscolour to "amberyellow">>
		<<headruined>>
		<<headwear "mushroom cap">>
		<<set $mushroom to $mushroomrestore>>
		<<set $mushroomtf to $mushroomtfrestore>>
		<<set $fungalgrowth to $fungalrestore>>
	<</if>>
	<<set V.transformationParts.doll.body to "disabled">>
	<<set V.transformationParts.doll.arms to "disabled">>
	<<set V.transformationParts.doll.string to "disabled">>
	<<set $dollstate to 0>>
<</widget>>

<<widget "prutihairdress">>
	<<wash>>
	<<rng>>
	<<if $player.gender_appearance is "f">>
		<<if $settings.forcedCrossdressingEnabled and $rng gte 51>>
			<<if $hairlength gte 200>><<set $hairlength to 100>><</if>>
			<<if $fringelength gte 400>><<set $fringelength to 250>><</if>>
			<<set _hairOptions to [
				{hair: "french bob", fringe: "blunt locks"},
				{hair: "neat", fringe: "french bob"},
				{hair: "ruffled", fringe: "emo left"},
				{hair: "layered bob", fringe: "messy curls"},
				{hair: "short", fringe: "framed"},
				{hair: "short spiky", fringe: "loose antenna"},
				{hair: "short", fringe: "sectioned"},
				{hair: "fishtail right", fringe: "overgrown"},
			]>>
		<<else>>
			<<if $hairlength lt 800 or $fringelength lt 500>>
				<<set $sexStats.pills.pills['Hair Growth Formula'].doseTaken += 6>>
			<</if>>
			<<if $hairlength gte 800>><<set $hairlength to 600>><</if>>
			<<if $fringelength gte 500>><<set $fringelength to 350>><</if>>
			<<set _hairOptions to [
				{hair: "fluffy pigtails", fringe: "fairy waves"},
				{hair: "magical ribbons", fringe: "front braids"},
				{hair: "ribbon tail", fringe: "heart rows"},
				{hair: "scorpion tails", fringe: "framing locks"},
				{hair: "princess ribbons", fringe: "princess wave"},
				{hair: "little doll", fringe: "little doll"},
				{hair: "princess ponytail", fringe: "milkmaid"},
				{hair: "ribbon tail", fringe: "framed"},
				{hair: "fairy low buns", fringe: "sideswept braid"},
				{hair: "sailor buns", fringe: "ringlets"},
				{hair: "drill ringlets", fringe: "hime"},
			]>>
		<</if>>
	<<else>>
		<<if $settings.forcedCrossdressingEnabled and $rng gte 51>>
			<<if $hairlength lt 800 or $fringelength lt 500>>
				<<set $sexStats.pills.pills['Hair Growth Formula'].doseTaken += 6>>
			<</if>>
			<<if $hairlength gte 800>><<set $hairlength to 600>><</if>>
			<<if $fringelength gte 500>><<set $fringelength to 350>><</if>>
			<<set _hairOptions to [
				{hair: "fluffy pigtails", fringe: "fairy waves"},
				{hair: "magical ribbons", fringe: "front braids"},
				{hair: "ribbon tail", fringe: "heart rows"},
				{hair: "scorpion tails", fringe: "framing locks"},
				{hair: "princess ribbons", fringe: "princess wave"},
				{hair: "little doll", fringe: "little doll"},
				{hair: "princess ponytail", fringe: "milkmaid"},
				{hair: "ribbon tail", fringe: "framed"},
				{hair: "fairy low buns", fringe: "sideswept braid"},
				{hair: "sailor buns", fringe: "ringlets"},
				{hair: "drill ringlets", fringe: "hime"},
			]>>
		<<else>>
			<<if $hairlength gte 200>><<set $hairlength to 100>><</if>>
			<<if $fringelength gte 400>><<set $fringelength to 250>><</if>>
			<<set _hairOptions to [
				{hair: "french bob", fringe: "blunt locks"},
				{hair: "neat", fringe: "french bob"},
				{hair: "ruffled", fringe: "emo left"},
				{hair: "layered bob", fringe: "messy curls"},
				{hair: "short", fringe: "framed"},
				{hair: "short spiky", fringe: "loose antenna"},
				{hair: "short", fringe: "sectioned"},
				{hair: "fishtail right", fringe: "overgrown"},
			]>>
		<</if>>
	<</if>>
	<<set _sameStyleIndex to _hairOptions.indexOf(style => style.hair is $hairtype)>>
	<<if _sameStyleIndex gte 0>><<run _hairOptions.deleteAt(_sameStyleIndex)>><</if>>
	<<set _selectedHairStyle to _hairOptions.random()>>
	<<set $hairtype to _selectedHairStyle.hair>>
	<<set $fringetype to _selectedHairStyle.fringe>>
	<<set $ruffledisable to "t">>
<</widget>>

<<widget "prutidressup">>
	<<wash>>
	<<strip>>
	<<if $player.gender_appearance is "f">>
		<<if $settings.forcedCrossdressingEnabled and $rng gte 51>>
			<<set _clothesOptions to [
				{upper: "gothic jacket", lower: "plaid school shorts", head: "top hat", legs: "men's garter socks", underlower: "bloomers", feet: "suede pumps"},
				{upper: "frilly rose wedding suit", head: "rose", underlower: "bloomers", feet: "wingtips"},
				{upper: "shadbelly coat", lower: "puffy shorts", head: "large bow beret", legs: "lace socks", underlower: "bloomers", feet: "platform mary janes"},
			]>>
		<<else>>
			<<set _clothesOptions to [
				{upper: "gothic gown", head: "lolita bonnet", legs: "harness garter stockings", underlower: "bloomers", feet: "knee fur boots"},
				{upper: "princess dress", head: "large lace bow", legs: "elegant knee-high socks", underlower: "bloomers", feet: "rose platform heels"},
				{upper: "puff sleeve a-line dress", head: "lolita headband", legs: "lace socks with ribbons", underlower: "bloomers", feet: "spat shoes"},
			]>>
		<</if>>
	<<elseif $player.gender_appearance is "m">>
		<<if $settings.forcedCrossdressingEnabled and $rng gte 51>>
			<<set _clothesOptions to [
				{upper: "gothic gown", head: "lolita bonnet", legs: "harness garter stockings", underlower: "bloomers", feet: "knee fur boots"},
				{upper: "princess dress", head: "large lace bow", legs: "elegant knee-high socks", underlower: "bloomers", feet: "rose platform heels"},
				{upper: "puff sleeve a-line dress", head: "lolita headband", legs: "lace socks with ribbons", underlower: "bloomers", feet: "spat shoes"},
			]>>
		<<else>>
			<<set _clothesOptions to [
				{upper: "gothic jacket", lower: "plaid school shorts", head: "top hat", legs: "men's garter socks", underlower: "bloomers", feet: "suede pumps"},
				{upper: "frilly rose wedding suit", head: "rose", underlower: "bloomers", feet: "wingtips"},
				{upper: "shadbelly coat", lower: "puffy shorts", head: "large bow beret", legs: "lace socks", underlower: "bloomers", feet: "platform mary janes"},
			]>>
		<</if>>
	<</if>>
	<<set _selectedClothesStyle to _clothesOptions.random()>>
	<<if _selectedClothesStyle.upper is "gothic gown">>
		<<upperwear _selectedClothesStyle.upper "white" "black">>
		<<headwear _selectedClothesStyle.head "black" "white">>
		<<legswear _selectedClothesStyle.legs "black" "black">>
		<<underlowerwear _selectedClothesStyle.underlower "white" "white">>
		<<feetwear _selectedClothesStyle.feet "black" "black">>
	<<elseif _selectedClothesStyle.upper is "princess dress">>
		<<upperwear _selectedClothesStyle.upper "teal" "white">>
		<<headwear _selectedClothesStyle.head "teal" "teal">>
		<<legswear _selectedClothesStyle.legs "white" "white">>
		<<underlowerwear _selectedClothesStyle.underlower "white" "white">>
		<<feetwear _selectedClothesStyle.feet "white" "white">>
	<<elseif _selectedClothesStyle.upper is "puff sleeve a-line dress">>
		<<upperwear _selectedClothesStyle.upper "light pink" "white">>
		<<headwear _selectedClothesStyle.head "light pink" "light pink">>
		<<legswear _selectedClothesStyle.legs "white" "white">>
		<<underlowerwear _selectedClothesStyle.underlower "white" "white">>
		<<feetwear _selectedClothesStyle.feet "white" "light pink">>
	<<elseif _selectedClothesStyle.upper is "gothic jacket">>
		<<upperwear _selectedClothesStyle.upper "black" "black">>
		<<lowerwear _selectedClothesStyle.lower "black" "black">>
		<<headwear _selectedClothesStyle.head "black" "black">>
		<<legswear _selectedClothesStyle.legs "black" "black">>
		<<underlowerwear _selectedClothesStyle.underlower "white" "white">>
		<<feetwear _selectedClothesStyle.feet "black" "black">>
	<<elseif _selectedClothesStyle.upper is "frilly rose wedding suit">>
		<<upperwear _selectedClothesStyle.upper "white" "red">>
		<<headwear _selectedClothesStyle.head "red" "red">>
		<<underlowerwear _selectedClothesStyle.underlower "white" "white">>
		<<feetwear _selectedClothesStyle.feet "white" "white">>
	<<elseif _selectedClothesStyle.upper is "shadbelly coat">>
		<<upperwear _selectedClothesStyle.upper "grey" "white">>
		<<lowerwear _selectedClothesStyle.lower "brown" "brown">>
		<<headwear _selectedClothesStyle.head "white" "brown">>
		<<legswear _selectedClothesStyle.legs "white" "white">>
		<<underlowerwear _selectedClothesStyle.underlower "white" "white">>
		<<feetwear _selectedClothesStyle.feet "black" "black">>
	<</if>>
<</widget>>

