:: New World Cheats [widget]

<<widget "cheats-newworld">>
	<div class="settingsToggleItem">
		<span class="gold">Taylor</span>
		<<numberStepper "<<symbol love>> Love" `C.npc.Taylor.love` { callback: value => { C.npc.Taylor.love = value }, max: 100 }>>
	</div>
	<div class="settingsToggleItem">
		<span class="gold">Casey</span>
		<<numberStepper "<<symbol love>> Love" `C.npc.Casey.love` { callback: value => { C.npc.Casey.love = value }, max: 100 }>>
		<<numberStepper "<<symbol pride>> Pride" `C.npc.Casey.dom` { callback: value => { C.npc.Casey.dom = value }, max: 50 }>>
	</div>
	<div class="settingsToggleItem">
		<span class="gold">Pruti</span>
		<<numberStepper "<<symbol love>> Love" `C.npc.Pruti.love` { callback: value => { C.npc.Pruti.love = value }, max: 100 }>>
	</div>
	<div class="settingsToggleItem">
		<span class="gold">Salem</span>
		<<numberStepper "<<symbol love>> Love" `C.npc.Salem.love` { callback: value => { C.npc.Salem.love = value }, max: 100 }>>
		<<numberStepper "<<symbol corruption>> Corruption" `C.npc.Salem.love` { callback: value => { C.npc.Salem.corruption = value }, max: 50 }>>
	</div>
	<div class="settingsToggleItem">
		<span class="gold">Haegish</span>
		<<numberStepper "<<symbol love>> Love" `C.npc.Haegish.love` { callback: value => { C.npc.Haegish.love = value }, max: 30 }>>
	</div>
<</widget>>