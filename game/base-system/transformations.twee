<</widget>>

<<widget "dragonTransform">>
	<<if $args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $dragonbuild gte 10 and $transformdisable is "f" and $physicalTransform isnot 1>>
					<<set $dragon to 1>><<set $physicalTransform to 1>>
					<span class="gold">Your eyes have turned a strange red and yellow. Your vision has improved.</span>
					<<cleareyes>>
					<<set $transformationParts.dragon.eyes to "default">>
					<<set $transformationParts.traits.sharpEyes to "hidden">>
					<br><br>
				<</if>>
			<<case 1>>
				<<if $dragonbuild gte 20 and $transformdisable is "f">>
					<<set $dragon to 2>>
					<span class="gold">Your mouth hurts for a moment. You lick your teeth and find sharp new fangs.</span>
					<<set $transformationParts.dragon.fangs to "default">>
					<<set $transformationParts.traits.fangs to "hidden">>
					<br><br>
				<<elseif $dragonbuild lt 10>>
					<<set $dragon to 0>><<set $physicalTransform to 0>>
					<span class="gold">Your vision has worsened significantly.</span>
					<<set $transformationParts.dragon.eyes to "disabled">>
					<<set $transformationParts.traits.sharpEyes to "disabled">>
					<br><br>
				<</if>>
			<<case 2>>
				<<if $dragonbuild gte 25 and $transformdisable is "f">>
					<<set $dragon to 3>>
					<span class="gold">Your head aches for a moment, and horns appear.</span>
					<<clearhorns>>
					<<set $transformationParts.dragon.horns to "default">>
					<br><br>
				<<elseif $dragonbuild lt 10>>
					<<set $dragon to 1>>
					<span class="gold">Your fangs have completely disappeared.</span>
					<<set $transformationParts.dragon.fangs to "disabled">>
					<<set $transformationParts.traits.fangs to "disabled">>
					<br><br>
				<</if>>
			<<case 3>>
				<<if $dragonbuild gte 30 and $transformdisable is "f">>
					<<set $dragon to 4>>
					<span class="gold">Your bottom feels strange. You reach behind you, and find a tail covered in rough scales.</span>
					<<cleartail>>
					<<set $transformationParts.dragon.tail to "default">>
					<<set $hastail to "true">>
					<<set $thicktail to "true">>
					<br><br>
				<<elseif $dragonbuild lt 20>>
					<<set $dragon to 2>>
					<span class="gold">Your horns have disappeared.</span>
					<<set $transformationParts.dragon.horns to "disabled">>
					<br><br>
				<</if>>
			<<case 4>>
				<<if $dragonbuild gte 40 and $transformdisable is "f">>
					<<set $dragon to 5>>
					<span class="gold">Your back itches.</span>
					<br><br>
				<<elseif $dragonbuild lt 30>>
					<<set $dragon to 3>>
					<span class="gold">Your tail is gone.</span>
					<<set $transformationParts.dragon.tail to "disabled">>
					<<set $hastail to "false">>
					<<set $thicktail to "false">>
					<br><br>
				<</if>>
			<<case 5>>
				<<if $dragonbuild gte 50 and $transformdisable is "f">>
					<<set $permanentTransform = 1>>
					<<set $dragontf = 1>>
					<<set $dragon to 6>>
					<span class="gold">You feel stronger and lighter than ever before.</span>
					<<clearwings>>
					<<set $transformationParts.dragon.wings to "default">>
					<<if $transformationParts.angel.wings is "default">>
						<<set $transformationParts.angel.wings to "hidden">>
					<<elseif $transformationParts.fallenAngel.wings is "default">>
						<<set $transformationParts.fallenAngel.wings to "hidden">>
					<<elseif $transformationParts.demon.wings is "default">>
						<<set $transformationParts.demon.wings to "hidden">>
					<</if>>
					<br><br>
				<<elseif $dragonbuild lt 40>>
					<<set $dragon to 4>>
					<span class="gold">You feel weaker.</span>
					<br><br>
				<</if>>
			<<case 6>>
				<<if $dragonbuild lt 50>>
					<span class="gold">You feel as weak as you once were. Your scaley wings have disappeared.</span>
					<<set $dragon to 5>>
					<<set $transformationParts.dragon.wings to "disabled">>
					<<if $angel gte 6>>
						<<set $transformationParts.angel.wings to "default">>
					<</if>>
					<<if $demon gte 6>>
						<<set $transformationParts.demon.wings to "default">>
					<</if>>
					<<if $fallenangel gte 2>>
						<<set $transformationParts.fallenAngel.wings to "default">>
					<</if>>
					<br><br>
					<<set $dragontf = 1>>
					<<set $permanentTransform = 1>>
				<</if>>
			<<case 99>>
				<<set $physicalTransform to 0>>
				<<set $dragon to 0>>
				<<set $dragonbuild to 0>>
				<<set $transformationParts.dragon.eyes to "disabled">>
				<<set $transformationParts.dragon.fangs to "disabled">>
				<<set $transformationParts.dragon.horns to "disabled">>
				<<set $transformationParts.dragon.tail to "disabled">>
				<<set $hastail to "false">>
				<<set $thicktail to "false">>
				<<set $transformationParts.dragon.wings to "disabled">>
		<</switch>>
	<<else>>
		<<clearAnimalTransformations>>
		<<set $physicalTransform to 1>>
		<<set $permanentTransform = 1>>
		<<set $dragontf = 1>>
		<<set $dragon to 6>>
		<<set $dragonbuild to 100>>
		<<cleareyes>>
		<<clearhorns>>
		<<cleartail>>
		<<clearwings>>
		<<set $transformationParts.dragon.eyes to "default">>
		<<set $transformationParts.dragon.fangs to "default">>
		<<set $transformationParts.dragon.horns to "default">>
		<<set $transformationParts.dragon.tail to "default">>
		<<set $hastail to "true">>
		<<set $thicktail to "true">>
		<<set $transformationParts.dragon.wings to "default">>
		<<if $transformationParts.angel.wings is "default">>
			<<set $transformationParts.angel.wings to "hidden">>
		<<elseif $transformationParts.fallenAngel.wings is "default">>
			<<set $transformationParts.fallenAngel.wings to "hidden">>
		<<elseif $transformationParts.demon.wings is "default">>
			<<set $transformationParts.demon.wings to "hidden">>
		<</if>>
	<</if>>
<</widget>>

<<widget "lizardTransform">>
	<<if $args[0] gte 0>>
		<<switch _args[0]>>
			<<case 0>>
				<<if $lizardbuild gte 10 and $transformdisable is "f" and $physicalTransform isnot 1>>
					<<set $lizard to 1>><<set $physicalTransform to 1>>
					<span class="gold">Your eyes have turned a strange red and yellow. Your vision has improved.</span>
					<<cleareyes>>
					<<set $transformationParts.lizard.eyes to "default">>
					<br><br>
				<</if>>
			<<case 1>>
				<<if $lizardbuild gte 20 and $transformdisable is "f">>
					<<set $lizard to 2>>
					<span class="gold">Your teeth ache for a moment, and fangs appear.</span>
					<<set $transformationParts.traits.fangs to "default">>
					<br><br>
				<<elseif $lizardbuild lt 10>>
					<<set $lizard to 0>><<set $physicalTransform to 0>>
					<span class="gold">Your vision has worsened significantly.</span>
					<<set $transformationParts.lizard.eyes to "disabled">>
					<br><br>
				<</if>>
			<<case 2>>
				<<if $lizardbuild gte 30 and $transformdisable is "f">>
					<<set $permanentTransform = 1>>
					<<set $lizardtf = 1>>
