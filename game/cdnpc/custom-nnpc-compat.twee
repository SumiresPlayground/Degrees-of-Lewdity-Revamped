:: Custom NNPC Compat Widgets [widget]

<<widget "custom-nnpc-packaged-compat-checker">>
    <<if $NPCNameList.includes("Riley") && ! setup.customNNPC.compatPatches.includes("Riley")>>
        <<run
            try{
                setup.customNNPC.moodCallback["Riley"] = function (data) {
                    return {
                        "blush": data.love >= 40 ? 1 : 0 + (data.lust >= 20 ? 1 : 0),
                        "anger": data.love <= -10 ? 1 : 0,
                        "smile": data.love >= 20 ? 1 : 0,
                        "trauma": false,
                    }
                };

                setup.customNNPC.defaultClothes["riley"] = {
                    "upper": [
                        {variable:"hoodie", colour1:"black", colour2:"black"},
                        {variable:"hoodie", colour1:"white", colour2:"white"}
                    ],
                    "lower": [
                        {variable:"shorts", colour1:"teal"},
                        {variable:"cargo shorts", colour1:"olive", colour2:"black"}
                    ],
                    "feet": [
                        {variable: "combat", colour1: "black"},
                        {variable: "combat", colour2: "brown"}
                    ]
                };

                setup.customNNPC.defaultHairstyles.push({
                  name: "Riley n",
                  gender: "n",
                  hair_fringe_name: "messy",
                  hair_side_name: ["sidecut", "short", "shaved"],
                  hair_fringe_length: ["short", "neck", "chest"],
                  hair_side_length: "short",
                  type: "Riley"
                });
                setup.customNNPC.compatPatches.push("Riley");
            }catch(e){
                console.error("Custom NNPC: Riley patch failed: " + e);
            }
        >>
    <</if>>

    <<run

        if(! V.customNNPC.compatPatches.includes("Poppy") && V.NPCNameList.includes("Poppy")){
            V.customNNPC.customData["Poppy"].body_type = "classic";
            V.customNNPC.customData["Poppy"].facestyle = "default";
            V.customNNPC.customData["Poppy"].facevariant = "default";
            V.NPCName[V.NPCNameList.indexOf("Poppy")].eyeColour = "dark blue";
            V.NPCName[V.NPCNameList.indexOf("Poppy")].hairColour = "crimson";

            V.customNNPC.compatPatches.push("Poppy");
        }
    >>

    <<if $NPCNameList.includes("Poppy") && ! setup.customNNPC.compatPatches.includes("Poppy")>>
        <<run
            try{
                setup.customNNPC.moodCallback["Poppy"] = function (data) {
                    return {
                        "blush": customNNPCGetBlush(data.love, 100, data.lust, 40),
                        "anger": customNNPCGetAnger(data.rage, 100),
                        "smile": data.patience > 10,
                        "trauma": false,
                    }
                };

                setup.customNNPC.canvasOptionsOverrides["Poppy"] = {};
                setup.customNNPC.canvasOptionsOverrides["Poppy"]["fallen_halo_type"] = "default";
                setup.customNNPC.canvasOptionsOverrides["Poppy"]["fox_tail_type"] = "default";
                setup.customNNPC.canvasOptionsOverrides["Poppy"]["fox_tail_layer"] = "back";
                setup.customNNPC.canvasOptionsOverrides["Poppy"]["fox_ears_type"] = "default";
                setup.customNNPC.canvasOptionsOverrides["Poppy"]["fallen_wings_type"] = "cherub-black";
                setup.customNNPC.canvasOptionsOverrides["Poppy"]["fallen_wings_layer"] = "black";

                setup.customNNPC.defaultClothes["poppyNeutral"] = $.extend(true,{},setup.customNNPC.defaultClothes["maleDefault"]);

                setup.customNNPC.defaultClothes["poppyLatexF"] = {
                    "upper": [{variable:"dress", colour1:"white"}],
                    "lower": [{variable:"schoolskirtshort", colour1:"black"}],
                    "under_upper": [{variable:"latexleotard", colour1:"black"}],
                    "under_lower": [{variable:"latexleotard", colour1:"black"}],
                    "legs": [{variable:"garterstockings", colour1:"black"}],
                    "hands": [{variable:"fingerlessgloves", colour1:"black"}],
                    "handheld": [{variable:"star purse", colour1:"yellow"}],
                    "feet": [{variable:"kittenheels", colour1:"black", colour2:"black"}],
                };
                setup.customNNPC.defaultClothes["poppyTownM"] = {
                    "neck": [{variable:"ringedcollar"}],
                    "upper": [{variable:"sweater"}],
                    "lower": [{variable:"breeches", colour1:"black"}],
                    "under_lower": [{variable:"briefs", colour1:"black"}],
                    "hands": [{variable:"fingerlessgloves", colour1:"black"}],
                    "feet": [{variable:"trainers", colour1:"black"}],
                };

                setup.customNNPC.defaultHairstyles.push({
                    name: "Poppy m",
                    gender : "m",
                    hair_fringe_name : "straight curl",
                    hair_side_name : "straight",
                    hair_fringe_length : "short",
                    hair_side_length : "short",
                    type: "Poppy"
                });
                setup.customNNPC.defaultHairstyles.push({
                    name: "Poppy f",
                    gender : "f",
                    hair_fringe_name : "split",
                    hair_side_name : "defined curl",
                    hair_fringe_length : "navel",
                    hair_side_length : "chest",
                    type: "Poppy"
                });
                setup.customNNPC.compatPatches.push("Poppy")
            }catch(e){
                console.error("Custom NNPC: Poppy patch failed: " + e);
            }
        >>
    <</if>>

    <<if $NPCNameList.includes("Pruti") && ! setup.customNNPC.compatPatches.includes("New World")>>
        <<run
                setup.customNNPC.moodCallback["Pruti"] = function (data) {
                    return {
                        "blush": customNNPCGetBlush(data.love, 100),
                        "anger": customNNPCGetAnger(data.love <= 50 ? 1 : 0),
