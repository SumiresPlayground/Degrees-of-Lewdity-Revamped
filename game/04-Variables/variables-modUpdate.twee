:: Widgets variablesModUpdate [widget]
<<widget "variablesModUpdate">>
	/* * * * * * * * * * * * * * * * * *
Put variables specific to World Expansion here. 
These variables will be by referred to by both new and old WE saves.

If you are encountering an issue with World Expansion variables, utilize the console in the web browser tab you're playing DoL on. Go to the console tab that also says "console". There should be an empty terminal below. Enter "V.modtest" without the quotes. 

If the result is "undefined", this widget is not called for some reason. If the result is "success", then either everything works, or the issue lies elsewhere. You may also use this method to test individual variables such as "V.slime" or "V.ghost".



	*/
	<<if $objectVersion is undefined>>
		<<set $objectVersion to {}>>
	<</if>>
	<<if $saveVersions is undefined>>
		<<set $saveVersions to [StartConfig.version]>>
	<<elseif $saveVersions.last() isnot StartConfig.version>>
		<<set $saveVersions.push(StartConfig.version)>>
	<</if>>
	<<if $saveId is undefined>>
		<<set $saveId to random(10000, 99999)>>
	<</if>>
	<<if $saveName is undefined>>
		<<set $saveName to "">>
	<</if>>

	<<if $modtest is undefined>>
		<<set $modtest to 1>>
	<</if>>

	<<updatePlants>>
	<<specialClothesUpdate>>
	<<generateNPCNameHairAndEyeColors>>

	<<if $farm isnot undefined>>
		<<if $farm.tractor is undefined>>
			<<set $farm.tractor to 0>>
			<<set $farm.tractorplough to false>>
			<<set $farm.tractorseeddrill to false>>
			<<set $farm.tractorharvester to false>>
			<<set $farm.tractorloader to false>>
		<</if>>
		<<if $farm.compostbin is undefined>>
			<<set $farm.compostbin to 0>>
		<</if>>
	<</if>>

	<<if $taylorgender is undefined>>
		<<if $malechance lt random(1, 100)>>
			<<set $taylorgender to "f">>
		<<else>>
			<<set $taylorgender to "m">>
		<</if>>
	<</if>>

	<<if $baileyCatchCounter is undefined>>
		<<set $baileypaychain to 0>>
		<<set $baileyCatchCounter to 0>>
	<</if>>

	<<if $bailey_dom lte 0>>
		<<set $bailey_dom to 1>>
	<</if>>

	<<if $christmas_bailey_lotus_day is undefined>>
		<<set $christmas_bailey_lotus_day to -999>>
	<</if>>

	<<if $stockholm_bailey is undefined>>
		<<set $stockholm_bailey to 0>>
	<</if>>

	<<if $baileyCardWins is undefined>>
		<<set $baileyCardWins to 0>>
	<</if>>

	<<if $bailey_title is undefined>>
		<<set $bailey_title to "Bailey">>
	<</if>>

	<<if $bailey_title_unlocked is undefined>>
		<<set $bailey_title_unlocked to false>>
	<</if>>

	<<if $creatorname is undefined>>
		<<set $NPCenable to "1">>
		<<set $creatorname to "cdnpc">>
		<<set $NPCstatic to "0">>
		<<set $NPCposition to "2">>
	<</if>>

	<<if $staticimages is undefined>>
		<<set $staticimages to "0">>
	<</if>>

	<<if $foregroundenable is undefined>>
		<<set $foregroundenable to "0">>
	<</if>>

	<<if $staticimages2 is undefined>>
		<<set $staticimages2 to "2">>
	<</if>>

	<<if $foregroundenable2 is undefined>>
		<<set $foregroundenable2 to "0">>
	<</if>>

	<<if $tempdisplay is undefined>>
		<<set $tempdisplay to "0">>
		<<set $pepperdisplay to "0">>
		<<set $condomdisplay to "0">>
	<</if>>

	<<if $titledisplay is undefined>>
		<<set $titledisplay to "1">>
	<</if>>

	<<if $locationoverwrite is undefined>>
		<<set $locationoverwrite to 0>>
	<</if>>

	<<if $fame.investigator is undefined>>
		<<set $fame.investigator to 0>>
	<</if>>

	<<if $caseyagain is undefined>>
		<<set $caseyagain to 0>>
		<<set $caseymet to 0>>
	<</if>>

	<<if $taylorgenitals is undefined>>
		<<if $taylorgender is "m">>
			<<if random(0, 99) gte $cbchance>>
				<<set $taylorgenitals to "penis">>
			<<else>>
				<<set $taylorgenitals to "vagina">>
			<</if>>
		<<elseif $taylorgender is "f">>
			<<if random(0, 99) gte $dgchance>>
				<<set $taylorgenitals to "vagina">>
			<<else>>
				<<set $taylorgenitals to "penis">>
			<</if>>
		<</if>>
	<</if>>

	<<if $caseygender is undefined>>
		<<if $malechance lt random(1, 100)>>
			<<set $caseygender to "f">>
		<<else>>
			<<set $caseygender to "m">>
		<</if>>
	<</if>>

	<<if $caseygenitals is undefined>>
		<<if $caseygender is "m">>
			<<if random(0, 99) gte $cbchance>>
				<<set $caseygenitals to "penis">>
			<<else>>
				<<set $caseygenitals to "vagina">>
			<</if>>
		<<elseif $caseygender is "f">>
			<<if random(0, 99) gte $dgchance>>
				<<set $caseygenitals to "vagina">>
			<<else>>
				<<set $caseygenitals to "penis">>
			<</if>>
		<</if>>
	<</if>>

	<<if $rowangender is undefined>>
		<<if $malechance lt random(1, 100)>>
			<<set $rowangender to "f">>
		<<else>>
			<<set $rowangender to "m">>
		<</if>>
	<</if>>

	<<if $rowangenitals is undefined>>
		<<if $rowangender is "m">>
			<<if random(0, 99) gte $cbchance>>
				<<set $rowangenitals to "penis">>
			<<else>>
				<<set $rowangenitals to "vagina">>
			<</if>>
		<<elseif $rowangender is "f">>
			<<if random(0, 99) gte $dgchance>>
				<<set $rowangenitals to "vagina">>
			<<else>>
				<<set $rowangenitals to "penis">>
			<</if>>
		<</if>>
	<</if>>

	<<if $mintmochagender is undefined>>
		<<if $malechance lt random(1, 100)>>
			<<set $mintmochagender to "f">>
		<<else>>
			<<set $mintmochagender to "m">>
		<</if>>
	<</if>>

	<<if $mintmochagenitals is undefined>>
		<<if $mintmochagender is "m">>
			<<if random(0, 99) gte $cbchance>>
				<<set $mintmochagenitals to "penis">>
			<<else>>
				<<set $mintmochagenitals to "vagina">>
			<</if>>
		<<elseif $mintgender is "f">>
			<<if random(0, 99) gte $dgchance>>
				<<set $mintmochagenitals to "vagina">>
			<<else>>
				<<set $mintmochagenitals to "penis">>
			<</if>>
		<</if>>
	<</if>>

	<<if $salemgender is undefined>>
		<<if $malechance lt random(1, 100)>>
			<<set $salemgender to "f">>
		<<else>>
			<<set $salemgender to "m">>
		<</if>>
	<</if>>

	<<if $salemgenitals is undefined>>
		<<if $salemgender is "m">>
			<<if random(0, 99) gte $cbchance>>
				<<set $salemgenitals to "penis">>
			<<else>>
				<<set $salemgenitals to "vagina">>
			<</if>>
		<<elseif $salemgender is "f">>
			<<if random(0, 99) gte $dgchance>>
				<<set $salemgenitals to "vagina">>
			<<else>>
				<<set $salemgenitals to "penis">>
			<</if>>
		<</if>>
	<</if>>

	<<if $prutigender is undefined>>
		<<if $malechance lt random(1, 100)>>
			<<set $prutigender to "f">>
		<<else>>
			<<set $prutigender to "m">>
		<</if>>
	<</if>>

	<<if $prutigenitals is undefined>>
		<<if $prutigender is "m">>
			<<if random(0, 99) gte $cbchance>>
				<<set $prutigenitals to "penis">>
			<<else>>
				<<set $prutigenitals to "vagina">>
			<</if>>
		<<elseif $prutigender is "f">>
			<<if random(0, 99) gte $dgchance>>
				<<set $prutigenitals to "vagina">>
			<<else>>
				<<set $prutigenitals to "penis">>
			<</if>>
		<</if>>
	<</if>>

	<<if $wolf gte 1 or $cat gte 1 or $harpy gte 1 or $cow gte 1 or $fox gte 1 or $sheep gte 1 or $bee gte 1 or $deer gte 1 or $bear gte 1 or $dragon gte 1 or $lizard gte 1 or $dolphin gte 1 or $dog gte 1 or $raccoon gte 1 or $fish gte 1 or $horse gte 1 or $pig gte 1 or $spider gte 1 or $frog gte 1>>
		<<set $physicalTransform to 1>>
		<<set $permanentTransform to 1>>
	<<else>>
		<<set $physicalTransform to 0>>
	<</if>>

	<<if $skulduggeryhands is undefined>>
		<<set $skulduggeryhands to 0>>
	<</if>>

	<<if $bjob is undefined>>
		<<set $bjob to 0>>
	<</if>>

	<<if $TaylorArrested is undefined>>
		<<set $TaylorArrested to 0>>
	<</if>>

	<<if $TaylorChase is undefined>>
		<<set $TaylorChase to 0>>
	<</if>>

	<<if $TaylorFreed is undefined>>
		<<set $TaylorFreed to 0>>
	<</if>>

	<<if $TaylorMissing is undefined>>
		<<set $TaylorMissing to 0>>
	<</if>>

	<<if $TaylorSeen is undefined>>
		<<set $TaylorSeen to 0>>
	<</if>>

	<<if $forestmansionstage is undefined>>
		<<set $forestmansionstage to 0>>
	<</if>>

	<<if $forestmansionpicked is undefined>>
		<<set $forestmansionpicked to 0>>
	<</if>>

	<<if $forestmansionkitchen is undefined>>
		<<set $forestmansionkitchen to 0>>
	<</if>>

	<<if $forestmansionhaunt is undefined>>
		<<set $forestmansionhaunt to 0>>
	<</if>>

	<<if $TaylorReadMansion is undefined>>
		<<set $TaylorReadMansion to 0>>
	<</if>>

	<<if $TaylorWith is undefined>>
		<<set $TaylorWith to 0>>
	<</if>>
	
	<<if $dencounter is undefined>>
		<<set $dencounter to 0>>
	<</if>>

	<<if $lustwake is undefined>>
		<<set $lustwake to 0>>
	<</if>>
	
	<<if V.transformationParts.sheep is undefined>>
		<<set $sheep to 0>> <<set $sheepbuild to 0>>
		<<set V.transformationParts.sheep to {ears:"disabled", tail:"disabled", horns:"disabled"}>>
		<<if $sheep gte 2>>
			<<set V.transformationParts.sheep.horns to "default">>
		<</if>>
		<<if $sheep gte 4>>
			<<set V.transformationParts.sheep.ears to "default">>
		<</if>>
		<<if $sheep gte 6>>
			<<set V.transformationParts.sheep.tail to "default">>
			<<set $hastail to "true">>
			<<set $thintail to "true">>
		<</if>>
	<</if>>

	<<if V.transformationParts.raccoon is undefined>>
		<<set $raccoon to 0>> <<set $raccoonbuild to 0>>
		<<set V.transformationParts.raccoon to {ears:"disabled", tail:"disabled", mask:"disabled"}>>
		<<if $raccoon gte 2>>
			<<set V.transformationParts.raccoon.mask to "default">>
			<<set V.transformationParts.traits.incognito to "default">>
			<<set V.transformationParts.traits.sharpEyes to "default">>
		<</if>>
		<<if $raccoon gte 4>>
			<<set V.transformationParts.raccoon.ears to "default">>
		<</if>>
		<<if $raccoon gte 6>>
			<<set V.transformationParts.raccoon.tail to "default">>
			<<set $hastail to "true">>
			<<set $thintail to "true">>
		<</if>>
	<</if>>

	<<if V.transformationParts.fish is undefined>>
		<<set $fish to 0>> <<set $fishbuild to 0>>
		<<set V.transformationParts.fish to {fins:"disabled", tail:"disabled"}>>
		<<if $fish gte 2>>
			<<set V.transformationParts.traits.aquatic to "default">>
		<</if>>
		<<if $fish gte 4>>
			<<set V.transformationParts.fish.fins to "default">>
		<</if>>
		<<if $fish gte 6>>
			<<set V.transformationParts.fish.tail to "default">>
			<<set V.transformationParts.traits.aquatail to "default">>
			<<set $hastail to "true">>
			<<set $thicktail to "true">>
			<<set $swimtail to "true">>
		<</if>>
	<</if>>

	<<if V.transformationParts.horse is undefined>>
		<<set $horse to 0>> <<set $horsebuild to 0>>
		<<set V.transformationParts.horse to {ears:"disabled", tail:"disabled"}>>
		<<if $horse gte 2>>
			<<set V.transformationParts.traits.vigorous to "default">>
		<</if>>
		<<if $horse gte 4>>
			<<set V.transformationParts.horse.ears to "default">>
		<</if>>
		<<if $horse gte 6>>
			<<set V.transformationParts.horse.tail to "default">>
			<<set V.transformationParts.traits.kicks to "default">>
			<<set $hastail to "true">>
			<<set $thintail to "true">>
		<</if>>
	<</if>>

	<<if V.transformationParts.pig is undefined>>
		<<set $pig to 0>> <<set $pigbuild to 0>>
		<<set V.transformationParts.pig to {ears:"disabled", tail:"disabled"}>>
		<<if $pig gte 2>>
			<<set V.transformationParts.traits.strongnose to "default">>
		<</if>>
		<<if $pig gte 4>>
			<<set V.transformationParts.pig.ears to "default">>
		<</if>>
		<<if $pig gte 6>>
			<<set V.transformationParts.pig.tail to "default">>
			<<set $hastail to "true">>
			<<set $thintail to "true">>
		<</if>>
	<</if>>

	<<if V.transformationParts.bunny is undefined>>
		<<set V.transformationParts.bunny to {ears:"disabled", tail:"disabled"}>>
	<</if>>

	<<if V.transformationParts.spider is undefined>>
		<<set $spider to 0>> <<set $spiderbuild to 0>>
		<<set V.transformationParts.spider to {eyes:"disabled", tail:"disabled"}>>
		<<if $spider gte 2>>
			<<set V.transformationParts.traits.fangs to "default">>
		<</if>>
		<<if $spider gte 4>>
			<<set V.transformationParts.spider.eyes to "default">>
			<<set V.transformationParts.traits.sharpEyes to "default">>
		<</if>>
		<<if $spider gte 6>>
			<<set V.transformationParts.spider.tail to "default">>
			<<set $hastail to "true">>
			<<set $thicktail to "true">>
		<</if>>
	<</if>>

	<<if V.transformationParts.frog is undefined>>
		<<set $frog to 0>> <<set $frogbuild to 0>>
		<<set V.transformationParts.frog to {eyes:"disabled", cheeks:"disabled"}>>
		<<if $frog gte 2>>
			<<set V.transformationParts.traits.lungs to "default">>
			<<set V.transformationParts.traits.kicks to "default">>
			<<set V.transformationParts.traits.longtongue to "default">>
			<<set V.transformationParts.traits.webbedfeet to "default">>
		<</if>>
		<<if $frog gte 4>>
			<<set V.transformationParts.frog.eyes to "default">>
		<</if>>
		<<if $frog gte 6>>
			<<set V.transformationParts.frog.cheeks to "default">>
		<</if>>
	<</if>>

	<<if V.transformationParts.eldritch is undefined>>
		<<set $eldritch to 0>>
		<<set V.transformationParts.eldritch to {eyes:"disabled", mist:"disabled", crown:"disabled", skin:"disabled", tentacle:"disabled"}>>
	<</if>>

	<<if V.transformationParts.deer is undefined>>
		<<set $deer to 0>> <<set $deerbuild to 0>>
		<<set V.transformationParts.deer to {ears:"disabled", tail:"disabled", horns:"disabled"}>>
		<<if $deer gte 2>>
			<<set V.transformationParts.deer.horns to "default">>
		<</if>>
		<<if $deer gte 4>>
			<<set V.transformationParts.deer.ears to "default">>
		<</if>>
		<<if $deer gte 6>>
			<<set V.transformationParts.deer.tail to "default">>
			<<set V.transformationParts.traits.kicks to "default">>
			<<set $hastail to "true">>
			<<set $thintail to "true">>
		<</if>>
	<</if>>

	<<if V.transformationParts.bear is undefined>>
		<<set $bear to 0>> <<set $bearbuild to 0>>
		<<set V.transformationParts.bear to {ears:"disabled", tail:"disabled"}>>
		<<if $bear gte 2>>
			<<set V.transformationParts.traits.fangs to "default">>
			<<set V.transformationParts.traits.strongnose to "default">>
		<</if>>
		<<if $bear gte 4>>
			<<set V.transformationParts.bear.ears to "default">>
		<</if>>
		<<if $bear gte 6>>
			<<set V.transformationParts.bear.tail to "default">>
			<<set V.transformationParts.traits.bearbuild to "default">>
			<<set $hastail to "true">>
			<<set $thintail to "true">>
		<</if>>
	<</if>>

	<<if V.transformationParts.bee is undefined>>
		<<set $bee to 0>> <<set $beebuild to 0>>
		<<set V.transformationParts.bee to {ears:"disabled", tail:"disabled", wings:"disabled"}>>
		<<if $bee gte 2>>
			<<set V.transformationParts.bee.ears to "default">>
		<</if>>
		<<if $bee gte 4>>
			<<set V.transformationParts.bee.tail to "default">>
			<<set $hastail to "true">>
			<<set $thicktail to "true">>
		<</if>>
		<<if $bee gte 6>>
			<<set V.transformationParts.bee.wings to "default">>
		<</if>>
	<</if>>

	<<if V.transformationParts.fae is undefined>>
		<<set V.transformationParts.fae to {wings:"disabled", fairies:"disabled"}>>
	<</if>>

	<<if V.transformationParts.dragon is undefined>>
		<<set $dragon to 0>> <<set $dragonbuild to 0>>
		<<set V.transformationParts.dragon to {eyes:"disabled", fangs:"disabled", horns:"disabled", tail:"disabled", wings:"disabled", whisker:"disabled"}>>
		<<if $dragon gte 1>>
			<<set V.transformationParts.dragon.eyes to "default">>
		<</if>>
		<<if $dragon gte 2>>
			<<set V.transformationParts.dragon.fangs to "default">>
		<</if>>
		<<if $dragon gte 3>>
			<<set V.transformationParts.dragon.horns to "default">>
		<</if>>
		<<if $dragon gte 4>>
			<<set V.transformationParts.dragon.tail to "default">>
			<<set $hastail to "true">>
			<<set $thicktail to "true">>
		<</if>>
		<<if $transformationParts.dragon.wings isnot "disabled">>
			<<set V.transformationParts.dragon.wings to "default">>
		<</if>>
	<</if>>

	<<if V.transformationParts.lizard is undefined>>
		<<set $lizard to 0>> <<set $lizardbuild to 0>>
		<<set V.transformationParts.lizard to {eyes:"disabled", tail:"disabled"}>>
		<<if $lizard gte 1>>
			<<set V.transformationParts.lizard.eyes to "default">>
		<</if>>
		<<if $lizard gte 2>>
			<<set V.transformationParts.traits.fangs to "default">>
		<</if>>
		<<if $lizard gte 6>>
			<<set V.transformationParts.lizard.tail to "default">>
			<<set $hastail to "true">>
			<<set $thicktail to "true">>
			<<set V.transformationParts.traits.lungs to "default">>
		<</if>>
	<</if>>

	<<if V.transformationParts.dolphin is undefined>>
		<<set $dolphin to 0>> <<set $dolphinbuild to 0>>
		<<set V.transformationParts.dolphin to {tail:"disabled"}>>
		<<if $dolphin gte 2>>
			<<set V.transformationParts.traits.lungs to "default">>
		<</if>>
		<<if $dolphin gte 4>>
			<<set V.transformationParts.dolphin.tail to "default">>
			<<set $hastail to "true">>
			<<set $thicktail to "true">>
			<<set $swimtail to "true">>
		<</if>>
		<<if $dolphin gte 6>>
			<<set V.transformationParts.traits.aquatail to "default">>
		<</if>>
	<</if>>

	<<if V.transformationParts.dog is undefined>>
		<<set $dog to 0>> <<set $dogbuild to 0>>
		<<set V.transformationParts.dog to {ears:"disabled", tail:"disabled"}>>
		<<if $dog gte 2>>
			<<set V.transformationParts.traits.fangs to "default">>
		<</if>>
		<<if $dog gte 4>>
			<<set V.transformationParts.dog.ears to "default">>
		<</if>>
		<<if $dog gte 6>>
			<<set V.transformationParts.dog.tail to "default">>
			<<set $hastail to "true">>
			<<set $thintail to "true">>
		<</if>>
	<</if>>

	<<if V.transformationParts.ghost is undefined>>
		<<set $ghost to 0>>
		<<set V.transformationParts.ghost to {eyes:"disabled", hitodama:"disabled", mist:"disabled", stream:"disabled", flame:"disabled"}>>
	<</if>>

	<<if V.transformationParts.ghost.mist is undefined>>
		<<set V.transformationParts.ghost.mist to "disabled">>
	<</if>>

	<<if V.transformationParts.eldritch.mist is undefined>>
		<<set V.transformationParts.eldritch.mist to "disabled">>
	<</if>>

	<<if V.transformationParts.ghost.stream is undefined>>
		<<set V.transformationParts.ghost.stream to "disabled">>
	<</if>>

	<<if V.transformationParts.ghost.flame is undefined>>
		<<set V.transformationParts.ghost.flame to "disabled">>
	<</if>>

	<<if V.transformationParts.slime is undefined>>
		<<set $slime to 0>>
		<<set V.transformationParts.slime to {bubble:"disabled", stream:"disabled", core:"disabled"}>>
	<</if>>

	<<if V.transformationParts.mushroom is undefined>>
		<<set $mushroom to 0>>
		<<set V.transformationParts.mushroom to {cap:"disabled", eyes:"disabled", spores:"disabled", mushrooms:"disabled"}>>
	<</if>>
	
	<<if V.transformationParts.eldritch is undefined>>
		<<set V.transformationParts.eldritch to {crown:"disabled", eyes:"disabled", mist:"disabled", tentacle:"disabled", skin:"disabled"}>>
	<</if>>

	<<if V.transformationParts.eldritch.skin is undefined>>
		<<set V.transformationParts.eldritch to {crown:"disabled", eyes:"disabled", mist:"disabled", tentacle:"disabled", skin:"disabled"}>>
	<</if>>

	<<if V.transformationParts.dragon.whisker is undefined>>
		<<set V.transformationParts.dragon.whisker to "disabled">>
	<</if>>

	<<if V.transformationParts.goblin is undefined>>
		<<set $gob to 0>>
		<<set V.transformationParts.goblin to {ears:"disabled"}>>
	<</if>>

	<<if V.transformationParts.zombie is undefined>>
		<<set $zombie to 0>>
		<<set V.transformationParts.zombie to {body:"disabled", head:"disabled", arms:"disabled", eyes:"disabled"}>>
	<</if>>

	<<if V.transformationParts.cosmic is undefined>>
		<<set $cosmic to 0>>
		<<set V.transformationParts.cosmic to {body:"disabled", head:"disabled", arms:"disabled", eyes:"disabled"}>>
	<</if>>

