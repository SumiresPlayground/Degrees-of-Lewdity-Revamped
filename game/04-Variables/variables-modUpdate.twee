	<<if $dragonbuild gte 30>>
		<<set $dragontf = 1>>
	<</if>>

	<<if $lizardbuild gte 30>>
		<<set $lizardtf = 1>>
	<</if>>

	<<if $dogbuild gte 30>>
		<<set $dogtf = 1>>
	<</if>>

	<<if $fishbuild gte 30>>
		<<set $fishtf = 1>>
	<</if>>

	<<if $horsebuild gte 30>>
		<<set $horsetf = 1>>
	<</if>>

	<<if $spiderbuild gte 30>>
		<<set $spidertf = 1>>
	<</if>>

	<<if $pigbuild gte 30>>
		<<set $pigtf = 1>>
	<</if>>

	<<if $frogbuild gte 30>>
		<<set $frogtf = 1>>
	<</if>>

	<<updateMuseumAntiques>>
	
	<<if $tailactiondefault is undefined>>
		<<set $tailaction to "rest">>
	<</if>>

	<<if $haircolourreset is undefined>>
		<<set $skinColor.naturalreset to $skinColor.natural>>
		<<set $haircolourreset to $haircolour>>
		<<set $hairfringecolourreset to $hairfringecolour>>
	<</if>>

	<<if $transformdisabletheseus is undefined>>
		<<if $transformdisable is "f">>
			<<set $transformdisabletheseus to "f">>
		<<else>>
			<<set $transformdisabletheseus to "t">>
		<</if>>
	<</if>>

	<<if $motherlylove is undefined>>
		<<set $motherlylove to false>>
	<</if>>
	<<if $cultsuspicion is undefined>>
		<<set $cultsuspicion to 0>>
	<</if>>
	<<updateNewNamedNpcs>>
<</widget>>
