:: lititles [widget]
<<widget "lititles">>
	<span id="lititles">
		<<if $titledisplay is "1">>
			<div class="lititles"
				style="
					position: absolute;
					top: -70px;
					left: 90px;
					width: fit-content;
					display: flex;
					flex-direction: column;
					gap: 2px;
				">
				<<if $loveInterest.primary is "Sydney" and C.npc.Sydney.purity <= 0>>
					<img draggable="false" @src='"img/li-titles/SydneyCorrupt.png"'>
				<<else>>
					<img draggable="false" @src='"img/li-titles/" + $loveInterest.primary + ".png"'>
				<</if>>
				<<if $loveInterest.secondary !== "None" and $loveInterest.secondary is "Sydney" and C.npc.Sydney.purity <= 0>>
					<img draggable="false" @src='"img/li-titles/SydneyCorrupt.png"'>
				<<elseif $loveInterest.secondary !== "None">>
					<img draggable="false" @src='"img/li-titles/" + $loveInterest.secondary + ".png"'>
				<</if>>
			</div>
		<</if>>
	</span>
<</widget>>

<<widget "lititles2">>
	<span id="lititles">
		<<if $titledisplay is "1">>
			<div class="lititles"
				style="
					position: relative;
					bottom: 710px;
					left: 700px;
					display: flex;
					flex-direction: column;
					gap: 2px;
					width: 40px;
					height: 40px;
				">
				<<if $loveInterest.primary is "Sydney" and C.npc.Sydney.purity <= 0>>
					<img draggable="false" @src='"img/li-titles/SydneyCorrupt.png"'>
				<<else>>
					<img draggable="false" @src='"img/li-titles/" + $loveInterest.primary + ".png"'>
				<</if>>
				<<if $loveInterest.secondary !== "None" and $loveInterest.secondary is "Sydney" and C.npc.Sydney.purity <= 0>>
					<img draggable="false" @src='"img/li-titles/SydneyCorrupt.png"'>
				<<elseif $loveInterest.secondary !== "None">>
					<img draggable="false" @src='"img/li-titles/" + $loveInterest.secondary + ".png"'>
				<</if>>
			</div>
		<</if>>
	</span>
<</widget>>