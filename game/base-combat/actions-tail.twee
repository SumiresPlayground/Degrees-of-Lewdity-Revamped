:: Widgets Actions Tail [widget]
<<widget "tailstab">>
	<<if $consensual isnot 1 and ($fightTargets is undefined or $fightTargets.includes($tailtarget))>>
		<<set _tailaction["Stab"] to "tailstab">>
	<</if>>
<</widget>>

<<widget "tailsmack">>
	<<if $consensual isnot 1 and ($fightTargets is undefined or $fightTargets.includes($tailtarget))>>
		<<set _tailaction["Smack"] to "tailsmack">>
	<</if>>
<</widget>>

<<widget "tailsilk">>
	<<if $consensual isnot 1 and ($fightTargets is undefined or $fightTargets.includes($tailtarget))>>
		<<set _tailaction["Spray"] to "tailsilk">>
	<</if>>
<</widget>>

<<widget "tailwag">>
	<<set _tailaction["Wag"] to "tailwag">>
<</widget>>