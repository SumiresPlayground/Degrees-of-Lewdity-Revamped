:: Widgets speech-Ash [widget]
<<widget "speech-ash">>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Ash") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Ash")>>
		<<He>> looks a bit worried. "I'm sorry are you okay? I didn't realize you were a virgin."
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Ash">>
		<<He>> smiles. "It's alright, this is my first time doing this too."
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Ash">>
		<<He>> smiles. "Looks like you could use a little more training here."
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Ash">>
		<<He>> continues to kiss you deeply. "I wonder who trained you to kiss like this."
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Black Wolf" "Great Hawk">>
				<<He>> speaks. "That's a wild animal, you have to be careful or you'll get hurt."
			<<case "Alex">>
				<<He>> freezes. "Alex? You mean the person who lives up the road? Why would you mention them?"
			<<default>>
				<<He>> speaks. "Who is that?" <<He>> sounds confused.
		<</switch>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<print `<<He>> looks at your $_sexToy and smirks. "` + [`Wow not what I expected from you.`, `I didn't think you were such a slut.`, `Don't get any bright ideas.`, `And what do you plan to do with that?`][random(0,3)] + `"`>>
	<<elseif $speechchastity is 1>>
		<<if $worn.genitals.name is "chastity parasite">>
			<<print [`<<He>> laughs. "Chastity, really?"`, `<<He>> raises an eyebrow. "Well that's your choice sweetheart"`, `<<He>> grips you tightly. "I'll still love you the best I can."`][random(0, 2)]>>
		<</if>>
	<</if>>
<</widget>>