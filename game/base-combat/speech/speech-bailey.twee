			<<print $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $bailey_dom gte 70>>
			<<print `<<He>> speaks. "How do I taste?" <<He>> doesn't let you answer. <<He>> just uses you. "Sounds like you can't get enough."`>>
		<<elseif $bailey_dom lte 30>>
			<<print $_stringsPre + `"Just shut up and choke on it, you little shit."`>>
