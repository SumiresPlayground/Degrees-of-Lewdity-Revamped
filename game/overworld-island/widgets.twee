<<widget "prutihuticon">>
	<<icon "prutihut.png">>
<</widget>>

<<widget "planeicon">>
	<<icon "plane.png">>
<</widget>>

<<widget "oasisicon">>
	<<icon "oasis.png">>
<</widget>>