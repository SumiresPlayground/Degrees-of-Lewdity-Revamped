:: Widgets Island [widget]

<<widget "passoutisland">>
    You've pushed yourself too much.
    <br><br>
    <<passout>>

    <<if $rng gte 1>>
    <<link [[Wake up|Island Rape]]>><<strip>><</link>>
    <</if>>

    <<pass 1 hour>>

    <<trauma 6>><<set $stress -= 2000>>
<</widget>>

<<widget "eventisland">>
	<<cleareventpool>>
    <<if $location is "desert">>
        <<addevent "islandant">>
    <<elseif $location is "forest" or $location is "snowforest">>
        <<addevent "islandwolf" .5>>
        <<addevent "islandlurker" .5>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "islandwolf">>
	<<beastNEWinit 1 wolf>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> emerges from between the trees, teeth bared.
	<<if $monster is 1>>
		"Found you," <<bhe>> barks. "Mine."
	<</if>>
	<br><br>
	<<link [[Next|Island Wolf]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandant">>
	<<beastNEWinit 1 ant>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> emerges from the sand, gnashing its teeth.
	<<if $monster is 1>>
		"Invader," <<bhe>> cackles. "Mine."
	<</if>>
	<br><br>
	<<link [[Next|Island Ant]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandlurker">>
	As you cross the mountain something leaps from the pile of <<if $weather is "snow">>snow<<else>>leaves<</if>>
	<br><br>
	<<link [[Next|Island Struggle]]>><<set $struggle_start to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>