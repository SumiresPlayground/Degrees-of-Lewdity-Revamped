:: Widgets Misland [widget]

<<widget "passoutisland">>
    You've pushed yourself too much.
    <br><br>
    <<passout>>

	<<rng 1 10>>
    <<if $rng gt 3>>
    	<<link [[Wake up|Misland Rape]]>><<strip>><</link>>
	<<else>>
		<<if $NPCName[$NPCNameList.indexOf("Pruti")].love gte 50>>
			<<link [[Wake up|Pruti Save]]>><<strip>><</link>>
		<<else>>
			<<link [[Wake up|Witch Intro]]>><<strip>>
			<<if $ghost is 1>>
				<<set $bodyless to 1>><<clearExtraTransformations>>
			<</if>>
			<</link>>
		<</if>>
    <</if>>
<</widget>>

<<widget "eventislanditem">>
	<<cleareventpool>>
    <<if $location is "beach">>
        <<addinlineevent "cannonball">>
			You stub your toe on something hard under the sand.
			<br><br>
			Digging it up reveals an old cannonball.
			<br><br>
			<<set $antiquemoney += 300>><<museumAntiqueStatus "antiquecannonball" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
	<<elseif $location is "desert">>
        <<addinlineevent "arttablet">>
			You spot a small stone corner sticking out of the sand.
			<br><br>
			Digging it up reveals an old painted stone tablet.
			<br><br>
			<<set $antiquemoney += 200>><<museumAntiqueStatus "antiquearttablet" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
		<<addinlineevent "terracottastatue">>
			You find a small structure in the desert.
			<br><br>
			The place is completely empty except for a small terracotta statue.
			<br><br>
			<<set $antiquemoney += 500>><<museumAntiqueStatus "antiqueterracottastatue" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
    <<elseif $location is "mforest">>
        <<if $redvial isnot 1>>
			<<addinlineevent "redvial">>
				As you traverse the slick damp forest you slip in the mud.
				<br><br>
				You get up wiping yourself up before something catches your eye. Half sunk in the mud you find an odd red vial.
				<br><br>
				<<set $antiquemoney += 1500>><<museumAntiqueStatus "antiqueredvial" "found">>
				<<link [[Next|Misland]]>><<set $redvial to 1>><<set $eventskip to 2>><</link>>
			<</addinlineevent>>
		<</if>>
		<<addinlineevent "tribemask">>
			While walking you find an old path leading to what looks like a large mound.
			<br><br>
			Hanging on a nearby tree is an old looking stone mask.
			<br><br>
			<<set $antiquemoney += 500>><<museumAntiqueStatus "antiquetribemask" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
		<<addinlineevent "ebonystatuette">>
			While exploring you find a dilapidated wooden shack.
			<br><br>
			The place looks like a mess but you find an old ebony statuette tucked inside a drawer.
			<br><br>
			<<set $antiquemoney += 800>><<museumAntiqueStatus "antiqueebonystatuette" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
	<<elseif $location is "glacier">>
        <<addinlineevent "glacierplant">>
			As you traverse the glacier you slip on the ice and fall.
			<br><br>
			You start to get up but see something under the ice. You take a moment to dig them out and find some frozen seeds.
			<br><br>
			<<set $antiquemoney += 1000>><<museumAntiqueStatus "antiqueglacierplant" "found">>
			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "eventisland">>
	<<cleareventpool>>
    <<if $location is "desert" or $location is "beach">>
		<<if $settings.bestialityEnabled or $monster is 1>>
			<<addevent "islandant">>
			<<addevent "islandhawk">>
			<<addevent "islandlizard">>
		<</if>>
    <<elseif $location is "mforest">>
		<<if $settings.bestialityEnabled or $monster is 1>>
       		<<addevent "islandwolf">>
		<</if>>
        <<if $settings.lurkersEnabled>>
			<<addevent "islandlurker">>
		<</if>>
			<<addevent "islandlurker">>
		<<if $settings.voreEnabled>>
			<<addevent "islandsnake">>
		<</if>>
		<<if $settings.bestialityEnabled or $monster is 1>>
			<<addevent "islandboar">>
			<<addevent "islandcat">>
		<</if>>
	<<elseif $location is "glacier">>
		<<if $settings.bestialityEnabled or $monster is 1>>
			<<addevent "islandbear">>
			<<addevent "islandgwolf">>
		<</if>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "eventislandsafe">>
	<<cleareventpool>>
    <<if $location is "beach">>
        <<addinlineevent "safeisland_beach">>
			A fresh ocean breeze brushes your skin and relaxes you.
			<<lstress>><<stress -1>>
			<br><br>

			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
	<<elseif $location is "desert">>
        <<addinlineevent "safeisland_sandstorm">>
			A gust of wind starts up blowing sand everywhere. It stings your eyes and lowers visibility.
			<<gstress>><<stress 1>>
			<<gpain>><<pain 2>>
			<br><br>

			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
    <<elseif $location is "mforest">>
        <<addinlineevent "safeisland_wolfhowl">>
			You hear a wolf howl in the distance.
			<<if $transformationParts.wolf.tail isnot "disabled">>
				<<garousal>><<arousal 600>>
			<<else>>
				<<gstress>><<stress 1>>
			<</if>>
			<br><br>

			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
			<br>
		<</addinlineevent>>
	<<elseif $location is "glacier">>
        <<addinlineevent "safeisland_snowstorm">>
			A gust of wind starts up blowing snow everywhere. It makes it really hard to see.
			<<gstress>><<stress 1>>
			<br><br>

			<<link [[Next|Misland]]>><<set $eventskip to 2>><</link>>
		<</addinlineevent>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "islandwolf">>
	<<beastNEWinit 1 wolf>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> emerges from between the trees, teeth bared.
	<<if $monster is 1>>
		"Found you," <<bhe>> barks. "Mine."
	<</if>>
	<br><br>
	<<link [[Next|Misland Wolf]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandgwolf">>
	<<beastNEWinit 1 wolf>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> emerges from the snowy mist.
	<<if $monster is 1>>
		"Found you," <<bhe>> barks. "Mine."
	<</if>>
	<br><br>
	<<link [[Next|Misland Wolf]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandhawk">>
	<<beastNEWinit 1 hawk>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> swoops down from the sky, talons at the ready.
	<<if $monster is 1>>
		"Lets play." <<bhe>> screeches.
	<</if>>
	<br><br>
	<<link [[Next|Misland Hawk]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandcat">>
	<<beastNEWinit 1 cat>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> slinks silently from the tree tops, claws sharpened toward you.
	<<if $monster is 1>>
		"My next meal." <<bhe>> licks <<bhis>> lips.
	<</if>>
	<br><br>
	<<link [[Next|Misland Cat]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandlizard">>
	<<beastNEWinit 1 lizard>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> digs up from the sand, fangs bared.
	<<if $monster is 1>>
		"Come into the sand." <<bhe>> croaks.
	<</if>>
	<br><br>
	<<link [[Next|Misland Lizard]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandsnake">>
	A long snake slides down from the treetops blocking your path with its huge slick body, it bares its fangs as it grabs you and begins to force you into its throat.
	<br><br>
	<<link [[Next|Misland Snake]]>><<set $molestationstart to 1>><<set $trance to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandboar">>
	<<beastNEWinit 1 boar>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> scampers from the brush, its tusks aim menacingly toward you.
	<<if $monster is 1>>
		"Get down now." <<bhe>> snorts.
	<</if>>
	<br><br>
	<<link [[Next|Misland Boar]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandant">>
	<<beastNEWinit 1 ant>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> emerges from the sand, gnashing its teeth.
	<<if $monster is 1>>
		"Invader," <<bhe>> cackles. "Mine."
	<</if>>
	<br><br>
	<<link [[Next|Misland Ant]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandlurker">>
	As you cross the mountain something leaps from the pile of <<if Weather.precipitation === "snow">>snow<<else>>leaves<</if>>
	<br><br>
	<<link [[Next|Misland Struggle]]>><<set $struggle_start to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

<<widget "islandbear">>
	<<beastNEWinit 1 bear>>
	<!-- Modified for monster people -->
	A lone <<beasttype>> emerges from snow, glaring at you with piercing eyes.
	<<if $monster is 1>>
		"Food," <<bhe>> cackles.
	<</if>>
	<br><br>
	<<link [[Next|Misland Bear]]>><<set $molestationstart to 1>><<set $eventskip to 3>><</link>>
	<br>
<</widget>>

