            <br>
        <</if>>
        <<if $islanddistance is 20 and $exposed gt 0>>
            You can't enter the village dressed like this.
            <br>
        <<elseif $islanddistance is 20>>
            <<link [[Enter the village (0:05)|Desert Village]]>><<pass 5>><</link>>
            <br>
        <</if>>
