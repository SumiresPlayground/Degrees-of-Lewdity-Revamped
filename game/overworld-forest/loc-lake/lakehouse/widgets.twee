:: Widgets Lake House [widget]
<<widget "passoutlakehouse">>
	<<if isPlayerNonparasitePregnancyEnding()>>
		<<pregnancyWatersBrokenPassout>>
	<<else>>
		<<link [[Everything fades to black...->Lake House Passout]]>><</link>>
	<</if>>
<</widget>>

<<widget "lakehouse_assault_intro">>
	<<if $lakehouse.pet1 is "dog" and $lakehouse.pet2 is "dog" and $lakehouse.dogTraining is true>>
		<span class="green">Your dogs are trained and ready to defend their master.</span><br>
	<<elseif $lakehouse.pet1 is "dog" and lakehouse.pet2 is "dog" and $lakehouse.dogTraining is false>>
		<span class="teal">Your dogs are ready to defend the house, but don't have any special training.</span><br>
	<<elseif $lakehouse.pet1 is "dog" or lakehouse.pet2 is "dog" and $lakehouse.dogTraining is true>>
		<span class="teal">Your dog is trained and ready to defend their master.</span><br>
	<<elseif $lakehouse.pet1 is "dog" or lakehouse.pet2 is "dog" and $lakehouse.dogTraining is false>>
		<span class="lblue">Your dog is ready to defend the lakehouse, but don't have any special training.</span><br>
	<</if>>
	<<if $lakehouse.wall gte 3>>
		<span class="green">The barbed metal fence around the lake is unclimbable. Attackers will need to cut their way in, which will take a while.</span>
	<<elseif $lakehouse.wall gte 2>>
		<span class="teal">The tall metal fence around the lake will greatly slow attackers.</span>
	<<elseif $lakehouse.wall gte 1>>
		<span class="lblue">The concrete wall around the lakehouse will slow attackers.</span>
	<<else>>
		<span class="purple">The attackers invade unimpeded.</span>
	<</if>>
	<br><br>
<</widget>>

<<widget "lakehouse_sleep_options">>
	<<nightmareCheck "Lake House Sleep">>

	<<if $sleeptrouble is 1 and $controlled is 0>>
		<<link [[Sleep for 10 hours|Lake House Sleep]]>><<set $sleephour to 10>><<incrementautosave>><</link>> (<<timeAfterXHours 10>>)<<ltiredness>>
		<br>
		<<link [[Sleep for 9 hours|Lake House Sleep]]>><<set $sleephour to 9>><<incrementautosave>><</link>> (<<timeAfterXHours 9>>)<<ltiredness>>
		<br>
	<</if>>
	<<link [[Sleep for 8 hours|Lake House Sleep]]>><<set $sleephour to 8>><<incrementautosave>><</link>> (<<timeAfterXHours 8>>)<<ltiredness>>
	<br>
	<<link [[Sleep for 7 hours|Lake House Sleep]]>><<set $sleephour to 7>><<incrementautosave>><</link>> (<<timeAfterXHours 7>>)<<ltiredness>>
	<br>
	<<link [[Sleep for 6 hours|Lake House Sleep]]>><<set $sleephour to 6>><<incrementautosave>><</link>> (<<timeAfterXHours 6>>)<<ltiredness>>
	<br>
	<<link [[Sleep for 5 hours|Lake House Sleep]]>><<set $sleephour to 5>><<incrementautosave>><</link>> (<<timeAfterXHours 5>>)<<ltiredness>>
	<br>
	<<link [[Sleep for 4 hours|Lake House Sleep]]>><<set $sleephour to 4>><<incrementautosave>><</link>> (<<timeAfterXHours 4>>)<<ltiredness>>
	<br>
	<<link [[Sleep for 3 hours|Lake House Sleep]]>><<set $sleephour to 3>><<incrementautosave>><</link>> (<<timeAfterXHours 3>>)<<ltiredness>>
	<br>
	<<link [[Sleep for 2 hours|Lake House Sleep]]>><<set $sleephour to 2>><<incrementautosave>><</link>> (<<timeAfterXHours 2>>)<<ltiredness>>
	<br>
	<<link [[Sleep for 1 hour|Lake House Sleep]]>><<set $sleephour to 1>><<incrementautosave>><</link>> &#8194;(<<timeAfterXHours 1>>)<<ltiredness>>
	<br>
	<<link [[Just sleep|Lake House Sleep]]>><<set $sleephour to -1>><<incrementautosave>><</link>> (??:??)<<ltiredness>>
	<br><br>
	<<link [[Climb out of bed|Lake House Bedroom]]>><<storeon "Lake House Bed">><<set $wardrobe_location to "lakehouse">><<loadTempHairStyle>><<wardrobeSelection>><<loadTempHairStyle>><</link>>
	<br><br>
<</widget>>

<<widget "lakehouseclearplot">>
	<<if $lakehouse.clearing lte 0 and $lakehouse.plots is 0>>
		<<set $lakehouse.clearing to 25>>
		<<set $lakehouse.plots += 1>>
		<<plots_init lakehouse 1 earth 3 medium>>
	<<elseif $lakehouse.clearing lte 0 and $lakehouse.plots lt 3>>
		<<set $lakehouse.clearing to 25>>
		<<set $lakehouse.plots += 1>>
		<<add_plot lakehouse earth 3 medium>>	
	<</if>>
<</widget>>

<<widget "lakehouse_upgrades_current">>
		<<if $lakehouse.build>>
		<<switch $lakehouse.build>>
			<<case "wall 1">>
				The foundations are being placed.
			<<case "wall 2">>
				A metal fence is being built atop the stone wall.
			<<case "wall 3">>
				Barbed wire is being affixed atop the fence.
			<<case "tower 1">>
				A watchtower is being constructed at the edge of the forest.
			<<case "tower 2">>
				Searchlights are being affixed atop the watchtower.
		<</switch>>
		<<if $lakehouse.build_timer is 1>>
			It'll be finished tomorrow.
		<<else>>
			It'll be finished in <<number $lakehouse.build_timer>> days.
		<</if>>
		<br><br>
	<</if>>
<</widget>>

<<widget "lakehouse_upgrades_status">>
	<<set _upgrade_count to 0>>
	Wall:
	<<if $lakehouse.wall gte 3 or $lakehouse.build is "wall 3">>
		<span class="green">As sturdy as can be</span>
		<<set _upgrade_count += 1>>
	<<elseif $lakehouse.wall is 2 or $lakehouse.build is "wall 2">>
		<<link [[Metal fence|Lake House Upgrades Wall 3]]>><</link>>
	<<elseif $lakehouse.wall is 1 or $lakehouse.build is "wall 1">>
		<<link [[Reinforce|Lake House Upgrades Wall 2]]>><</link>>
	<<else>>
		<<link [[Full repair|Lake House Upgrades Wall 1]]>><</link>>
	<</if>>
	<br>
	Security:
	<<if $lakehouse.tower is 2 or $lakehouse.build is "tower 2">>
		<span class="green">As watchful as can be</span>
		<<set _upgrade_count += 1>>
	<<elseif $lakehouse.tower is 1 or $lakehouse.build is "tower 1">>
		<<link [[Searchlights|Lake House Upgrades Tower 2]]>><</link>>
	<<else>>
		<<link [[Watchtower|Lake House Upgrades Tower]]>><</link>>
	<</if>>
	<br>
	Lakehouse Irrigation:
	<<if $lakehouse.irrigation gte 9>>
		<span class="green">Every field has irrigation</span>
		<<set _upgrade_count += 1>>
	<<elseif $lakehouse.irrigation is $plots.lakehouse.length>>
		<span class="green">Every current field has irrigation</span>
	<<else>>
		<<link [[Build field irrigation|Lakehouse Upgrades Irrigation]]>><</link>>
	<</if>>
	<br>
	<<if ($sexStats.anus.pregnancy.motherStatus gte 1 or $sexStats.vagina.pregnancy.motherStatus gte 1) and ($lakehouse.parasitebarn gte 1 or $lakehouse.build is "parasites 1")>>
		Parasite Barn:
		<<if $lakehouse.parasitebarn gte 2 or $lakehouse.build is "parasites 2">>
			<span class="green">As big as can be</span>
		<<else>>
			<<link [[Expand|Lakehouse Upgrades Parasite Barn 2]]>><</link>>
		<</if>>
		<br>
	<</if>>
	<br>
<</widget>>

<<widget "lakehouse_build_day">>
	<<if $lakehouse_stage gte 7>>
		<<if $lakehouse.build_timer gte 1>>
			<<set $lakehouse.build_timer -= 1>>
		<</if>>
		<<if $lakehouse.build_timer lte 0>>
			<<switch $lakehouse.build>>
				<<case "wall 1">>
					<<set $lakehouse.wall to 1>>
				<<case "wall 2">>
					<<set $lakehouse.wall to 2>>
				<<case "wall 3">>
					<<set $lakehouse.wall to 3>>
				<<case "wall 4">>
					<<set $lakehouse.wall to 4>>
				<<case "tower 1">>
					<<set $lakehouse.tower to 1>>
				<<case "tower 2">>
					<<set $lakehouse.tower to 2>>
				<<case "woodland 1">>
					<<set $lakehouse.woodland to 1>>
				<<case "woodland 2">>
					<<set $lakehouse.woodland to 2>>
				<<case "woodland 3">>
					<<set $lakehouse.woodland to 3>>
				<<case "kennel 1">>
					<<set $lakehouse.kennel to 1>>
				<<case "barn 1">>
					<<set $lakehouse.barn to 1>>
				<<case "barn 2">>
					<<set $lakehouse.barn to 2>>
				<<case "stable 1">>
					<<set $lakehouse.stable to 1>>
				<<case "coop 1">>
					<<set $lakehouse.coop to 1>>
				<<case "coop 2">>
					<<set $lakehouse.coop to 2>>
				<<case "parasites 1">>
					<<set $lakehouse.parasitebarn to 1>>
				<<case "parasites 2">>
					<<set $lakehouse.parasitebarn to 2>>
					<<set _container to $container.lakehouse>>
					<<set _container.upgrades.capacity to 1>>
					<<set _container.maxCount to 7>>
					<<set _container.upgrades.foodStorage to 1>>
					<<set _container.maxDaysWithoutFood to 31>>
					<<set _container.upgrades.luxury to 3>>
				<<case "irrigation">>
					<<if $lakehouse.irrigation is undefined>>
						<<set $lakehouse.irrigation to 1>>
					<<elseif $lakehouse.irrigation lt 9>>
						<<set $lakehouse.irrigation++>>
					<</if>>
			<</switch>>
			<<set $lakehouse.build to 0>>
		<</if>>
	<</if>>
<</widget>>

<<widget "farm_assault_init">>
	<<set $farm_assault to {}>>
	<<set $farm_assault.no to [0, 1, 2, 3]>>
	<<if $farm_stage gte 8>>
		<<set $farm_assault.no.push(4)>>
	<</if>>
	<<if $farm_stage gte 9>>
		<<set $farm_assault.no.push(5)>>
	<</if>>
	<<if $farm_stage gte 10>>
		<<set $farm_assault.no.push(6)>>
	<</if>>
	<<if $farm_stage gte 11>>
		<<set $farm_assault.no.push(7)>>
	<</if>>
	<<if $farm_stage gte 12>>
		<<set $farm_assault.no.push(8)>>
	<</if>>
	<<set $farm_assault.teams to {}>>

	<<if $farm_stage gte 12>>
		<<set $farm_assault.teams.team_1 to {}>>
		<<set $farm_assault.teams.team_2 to {}>>
		<<set $farm_assault.teams.team_3 to {}>>
		<<set $farm_assault.teams.team_4 to {}>>
		<<set $farm_assault.teams.team_5 to {}>>
		<<if $bailey_encroach>>
			<<set $farm_assault.teams.team_6 to {}>>
			<<set $farm_assault.teams.team_6.type to "bailey">>
		<</if>>
	<<elseif $farm_stage gte 10>>
		<<set $farm_assault.teams.team_1 to {}>>
		<<set $farm_assault.teams.team_2 to {}>>
		<<set $farm_assault.teams.team_3 to {}>>
		<<set $farm_assault.teams.team_4 to {}>>
		<<if $bailey_encroach>>
			<<set $farm_assault.teams.team_5 to {}>>
			<<set $farm_assault.teams.team_5.type to "bailey">>
		<</if>>
	<<elseif $farm_stage gte 8>>
		<<set $farm_assault.teams.team_1 to {}>>
		<<set $farm_assault.teams.team_2 to {}>>
		<<set $farm_assault.teams.team_3 to {}>>
		<<if $bailey_encroach>>
			<<set $farm_assault.teams.team_4 to {}>>
			<<set $farm_assault.teams.team_4.type to "bailey">>
		<</if>>
	<<else>>
		<<set $farm_assault.teams.team_1 to {}>>
		<<set $farm_assault.teams.team_2 to {}>>
		<<if $bailey_encroach>>
			<<set $farm_assault.teams.team_3 to {}>>
			<<set $farm_assault.teams.team_3.type to "bailey">>
		<</if>>
	<</if>>
	<<set _assault_keys to Object.keys($farm_assault.teams)>>
	<<for _s to 0; _s lt _assault_keys.length; _s++>>
		<<set $farm_assault.teams[_assault_keys[_s]].location to $farm_assault.no.pluck()>>
		<<set $farm_assault.teams[_assault_keys[_s]].wall_progress to 0>>
		<<set $farm_assault.teams[_assault_keys[_s]].field_progress to 0>>
		<<set $farm_assault.teams[_assault_keys[_s]].number to 3>>
		<<if $wraith.state is "haunt" and $farm_assault.wraith is undefined and $hallucinations gte 2 and random(1,15-Math.floor(C.npc["Ivory Wraith"].lust/5)) is 1>>
			<<set $farm_assault.teams[_assault_keys[_s]].type to "wraith">>
			<<set $farm_assault.teams[_assault_keys[_s]].number to 1>>
			<<set $farm_assault.teams[_assault_keys[_s]].torched to 0>>
			<<set $farm_assault.wraith to _s>>
		<</if>>
		<<if !$farm_assault.teams[_assault_keys[_s]].type>>
			<<set $farm_assault.teams[_assault_keys[_s]].type to "remy">>
		<</if>>
	<</for>>
	<<set $fields_damaged to 0>>
	<<if $farm.kennel gte 1>>
		<<set $farm_assault.dogs to 2>>
	<<else>>
		<<set $farm_assault.dogs to 1>>
	<</if>>
	<<set $farm_assault.dogs_state to "guarding">>
	<<if $farm.tower_guard>>
		<<set $farm_assault.tower to "manned">>
	<<else>>
		<<set $farm_assault.tower to "empty">>
	<</if>>
	<<set $farm_assault.alex to "patrol">>
<</widget>>
