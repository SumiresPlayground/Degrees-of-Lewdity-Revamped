<<widget "cam1payout">>
	/* Total Fame */
	<<set _fame to ($fame.sex + $fame.prostitution + $fame.rape + $fame.bestiality + $fame.exhibitionism + $fame.pregnancy + $fame.impreg + $fame.scrap + $fame.good + $fame.business + $fame.social + $fame.model + $fame.investigator)>>
	
	/* Base */
	<<set _payout to 600>>
	/* Dance Skill */
	<<set _payout += (600 * Math.clamp(currentSkillValue('danceskill') / 1000, 0, 1))>>
	/* Allure */
	<<set _payout += (600 * Math.clamp($allure / (6000 * $settings.allureModifier), 0, 1))>>
	/* Fame */
	<<set _payout += (600 * Math.clamp(_fame / 4000, 0, 1))>>
	
	<<set $campayout to (_payout)>>
<</widget>>

<<widget "cam2payout">>
