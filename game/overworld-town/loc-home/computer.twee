<<widget "requestPage">>
<<silently>>
<<if $dailyghostmission is undefined or $dailyghostmission is 0>>
	<<if $fame.investigator gte 400 and $cursedshopintro isnot 1>>
		<<set _all to [
			{label: "Special Request",   text:  "Head to the commercial alleyways, make sure you're not followed."}
		]>>
	<<else>>
		<<set _all to [
			{label:"Strange Creaking",   text:"A strange creaking has been coming from my attic, can someone help?"},
			{label:"Weird Creature",   text:"There is something living in my walls, does anybody know what this is?"},
			{label:"Rattling Trashcans",   text:"Something keeps rummaging through my garbage. Exterminator needed."},
			{label:"Hissing from Garage",   text:"Some kind of animal or something keeps hissing from the garage."},
			{label:"Something in Cupboard",   text:"Every night, there is a strange scratching from the cupboard."},
			{label:"Strange Holes",   text:"Strange holes are appearing in my lawn, anybody recognize these?"},
			{label:"Something Following",   text:"I feel like something is following me, can someone investigate?"},
			{label:"Cracked Wall",   text:"Strange cracks keep appearing on my wall out of nowhere."}
			]>>
		<<if $fame.investigator gte 400>>
			<<set _all.pushUnique(
				{label:"Stuff Disappearing",   text:"Goods and valuables keep disappearing from the factory at night."}
			)>>
		<</if>>
		<<if $fame.investigator gte 1600>>
			<<if $settings.goreEnabled>>
				<<set _all.pushUnique(
					{label:"Unknown Blood",   text:"A strange blood-like substance keeps flowing up the hospital drains."}
				)>>
			<</if>>
		<</if>>
		<<set _requests to []>>
		<<for _i to 0; _i lt 5; _i++>>
			<<set _choice to _all.random()>>
			<<set _all.delete(_choice)>>
			<<set _requests.push(_choice)>>
		<</for>>
		<<set $dailyghostmission to _requests>>
	<</if>>
<</if>>
<<set _requests to $dailyghostmission>>
<</silently>>

<div class="ghost-blog">
	<h2 class="red">Trigger warning</h2>
	<span class="red">If the gore setting is enabled, some of these jobs may contain disturbing events.</span>
	<br><br>
	<h1 class="ghost-title">Paranormal Requests</h1>
	<ul class="request-list">
		<<for _i to 0; _i lt _requests.length; _i++>>
			<<set _r = _requests[_i]>>
			<<capture _r>>
			<li class="request-item<<if $acceptedRequest is _r.label>> accepted<</if>>">
				<span class="request-label"><<print _r.label>></span>
				<span class="request-text"><<print _r.text>></span>
				<br>
				<<if $completedRequest1 is _r.label>>
					<<button "Completed Quest">>
					<</button>>
				<<elseif $completedRequest2 is _r.label>>
					<<button "Completed Quest">>
					<</button>>
				<<elseif $completedRequest3 is _r.label>>
					<<button "Completed Quest">>
					<</button>>
				<<elseif $completedRequest4 is _r.label>>
					<<button "Completed Quest">>
					<</button>>
				<<elseif $completedRequest5 is _r.label>>
					<<button "Completed Quest">>
					<</button>>
				<<elseif $acceptedRequest isnot _r.label>>
					<<button "Accept">>
						<<set $acceptedRequest to _r.label>>
						<<run Engine.play(State.passage)>>
					<</button>>
				<<elseif $acceptedRequest is _r.label>>
					<<button "Current Quest">>
					<</button>>
				<</if>>
			</li>
			<</capture>>
		<</for>>
	</ul>

	<div class="ghost-footer">
		<<if $acceptedRequest>>
			Accepted request: «$acceptedRequest»
			<br>
			<<if $acceptedRequest is "Strange Creaking" or $acceptedRequest is "Weird Creature" or $acceptedRequest is "Something in Cupboard" or $acceptedRequest is "Something Following">>
				The request location is on «Domus Street»
			<<elseif $acceptedRequest is "Rattling Trashcans" or $acceptedRequest is "Hissing from Garage" or $acceptedRequest is "Strange Holes" or $acceptedRequest is "Cracked Wall">>
				The request location is on «Danube Street»
			<<elseif $acceptedRequest is "Stuff Disappearing">>
				The request location is on «Harvest Street»
			<<elseif $acceptedRequest is "Unknown Blood">>
				The request location is on «Nightingale Street»
			<<elseif $acceptedRequest is "Special Request">>
				<li><span class="ghost-footer">The request location is in the «Commercial Alleyways»</span></li>
			<</if>>
			<br>
		<</if>>
		Stay vigilant… the night is watching.
	</div>
</div>
<</widget>>